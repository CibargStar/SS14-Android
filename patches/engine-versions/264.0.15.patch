+internal sealed class MobileWidgetSlot
+{
+    public readonly Control Source;
+    private readonly Control _parent;
+    private readonly int _index;
+    private readonly Vector2 _min, _max, _set;
+    private readonly Thickness _margin;
+    private readonly Control.HAlignment _horizontal;
+    private readonly Control.VAlignment _vertical;
+    private readonly bool _expandX, _expandY;
+
+    public MobileWidgetSlot(Control source)
+    {
+        Source = source;
+        _parent = source.Parent!;
+        _index = source.GetPositionInParent();
+        _min = source.MinSize; _max = source.MaxSize; _set = source.SetSize;
+        _margin = source.Margin;
+        _horizontal = source.HorizontalAlignment; _vertical = source.VerticalAlignment;
+        _expandX = source.HorizontalExpand; _expandY = source.VerticalExpand;
+    }
+
+    public void MoveTo(Control parent)
+    {
+        Source.Parent?.RemoveChild(Source);
+        Source.MinSize = Vector2.Zero;
+        Source.SetSize = new Vector2(float.NaN);
+        Source.MaxSize = new Vector2(float.PositiveInfinity);
+        Source.Margin = new Thickness(0);
+        Source.HorizontalAlignment = Control.HAlignment.Stretch;
+        Source.VerticalAlignment = Control.VAlignment.Stretch;
+        Source.HorizontalExpand = Source.VerticalExpand = true;
+        parent.AddChild(Source);
+    }
+
+    public void Restore()
+    {
+        Source.Parent?.RemoveChild(Source);
+        if (Source.Disposed) return;
+        Source.MinSize = _min; Source.MaxSize = _max; Source.SetSize = _set;
+        Source.Margin = _margin;
+        Source.HorizontalAlignment = _horizontal; Source.VerticalAlignment = _vertical;
+        Source.HorizontalExpand = _expandX; Source.VerticalExpand = _expandY;
+        if (_parent.Disposed) return;
+        _parent.AddChild(Source);
+        Source.SetPositionInParent(Math.Min(_index, _parent.ChildCount - 1));
+    }
+}
