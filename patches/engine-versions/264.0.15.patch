+        private void DispatchTouchMouse(TouchMouseAction action, ScreenCoordinates coordinates)
+        {
+            foreach (var window in _windows)
+            {
+                if (window.Id != coordinates.Window) continue;
+                var delta = coordinates.Position - window.LastMousePos;
+                window.LastMousePos = coordinates.Position;
+                _currentHoveredWindow = window;
+                MouseMove?.Invoke(new MouseMoveEventArgs(delta, coordinates));
+                if (action == TouchMouseAction.Move) return;
+                var key = new KeyEventArgs(Keyboard.Key.MouseLeft, false, false, false, false, false, 0);
+                if (action == TouchMouseAction.Down) KeyDown?.Invoke(key);
+                else KeyUp?.Invoke(key);
+                return;
+            }
+        }
+
+        private void SendTouchFinger(TouchFingerEventArgs ev)
+        {
+            _eventDispatchQueue.Enqueue(new DEventTouchFinger(ev));
+        }
