+namespace Robust.Client.UserInterface.Mobile;
+
+// Keep the live server controls and their ancestor handlers. Only the native
+// layout containers change; no Content types or downloaded assemblies are edited.
+internal interface IMobileScreenBinding
+{
+    Control Source { get; }
+    void Update(Vector2 viewport, float chatHeight);
+    void Restore();
+    bool OwnsScroll(ScrollContainer scroll);
+}
