diff --git a/Robust.Client/UserInterface/Mobile/MobileLateJoinLayout.cs b/Robust.Client/UserInterface/Mobile/MobileLateJoinLayout.cs
new file mode 100644
index 0000000..bccc6b1
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileLateJoinLayout.cs
@@ -0,0 +1,129 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// Reuse the live JobButtons: availability, locks and SelectedId stay server-owned.
+internal sealed class MobileLateJoinBinding : IMobileScreenBinding
+{
+    public Control Source => _window;
+    private readonly BaseWindow _window;
+    private readonly Vector2 _min, _max, _set, _position;
+    private readonly bool _resizable;
+    private readonly List<DepartmentPage> _pages = new();
+    private readonly Dictionary<Control, Vector2> _buttons = new();
+    private long _nextScan;
+
+    public MobileLateJoinBinding(BaseWindow window)
+    {
+        _window = window; _min = window.MinSize; _max = window.MaxSize; _set = window.SetSize;
+        _position = window.Position; _resizable = window.Resizable;
+        window.MinSize = Vector2.Zero; window.Resizable = false;
+    }
+
+    public void Update(Vector2 viewport, float chatHeight)
+    {
+        var available = _window.Parent?.Size ?? viewport;
+        var size = Vector2.Max(Vector2.One, available - new Vector2(16));
+        if (_window.MaxSize != size) _window.MaxSize = size;
+        if (_window.SetSize != size) _window.SetSize = size;
+        if (_window.Position != new Vector2(8)) LayoutContainer.SetPosition(_window, new Vector2(8));
+        foreach (var page in _pages.ToArray())
+            if (page.Scroll.Disposed || !page.Scroll.IsInsideTree) { page.Restore(); _pages.Remove(page); }
+        if (Environment.TickCount64 >= _nextScan)
+        {
+            _nextScan = Environment.TickCount64 + 250;
+            foreach (var button in _buttons.Keys.Where(c => c.Disposed).ToArray()) _buttons.Remove(button);
+            var all = MobileServerUiAdapter.Tree(_window).ToArray();
+            foreach (var scroll in all.OfType<ScrollContainer>())
+            {
+                if (_pages.Any(p => p.Scroll == scroll) || scroll.Parent is not BoxContainer parent) continue;
+                var list = scroll.Children.OfType<BoxContainer>().FirstOrDefault();
+                if (list == null) continue;
+                var categories = list.Children.Where(c => MobileServerUiAdapter.Tree(c).Any(n => MobileServerUiAdapter.TypeIs(n, "JobButton"))).ToArray();
+                if (categories.Length > 0) _pages.Add(new DepartmentPage(scroll, parent, list, categories));
+            }
+            foreach (var button in all.Where(c => c is BaseButton && (MobileServerUiAdapter.TypeIs(c, "JobButton") || c.Name == "CloseButton")))
+            {
+                if (!_buttons.ContainsKey(button)) _buttons.Add(button, button.MinSize);
+                var minimum = Vector2.Max(button.MinSize, new Vector2(38));
+                if (button.MinSize != minimum) button.MinSize = minimum;
+            }
+        }
+        foreach (var page in _pages) page.Columns(size.X >= 760 ? 2 : 1);
+    }
+
+    public bool OwnsScroll(ScrollContainer scroll)
+    {
+        for (Control? c = scroll; c != null; c = c.Parent) if (c == _window) return true;
+        return _pages.Any(p => p.Selector.OptionsScroll == scroll);
+    }
+
+    public void Restore()
+    {
+        foreach (var page in _pages) page.Restore(); _pages.Clear();
+        foreach (var (button, min) in _buttons) if (!button.Disposed) button.MinSize = min;
+        if (_window.Disposed) return;
+        _window.MinSize = _min; _window.MaxSize = _max; _window.SetSize = _set; _window.Resizable = _resizable;
+        LayoutContainer.SetPosition(_window, _position);
+    }
+
+    private sealed class DepartmentPage
+    {
+        public readonly ScrollContainer Scroll;
+        public readonly OptionButton Selector = new MobileProfileSectionButton { Name = "MobileLateJoinDepartments", MinHeight = 36 };
+        private readonly GridContainer _grid = new() { Name = "MobileLateJoinJobs", Columns = 1, HSeparationOverride = 12, VSeparationOverride = 6 };
+        private readonly List<(MobileWidgetSlot Slot, bool Visible)> _slots = new();
