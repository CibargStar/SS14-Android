+internal sealed class MobileGuidebookPanel : Container
+{
+    public readonly Control Navigation = new() { Name = "MobileGuideNavigation" };
+    public readonly Control Article = new() { Name = "MobileGuideArticle" };
+    private readonly Button _sections;
+    private bool? _showNavigation;
+
+    public MobileGuidebookPanel()
+    {
+        Name = "MobileGuidebookPanel";
+        RectClipContent = true;
+        _sections = new Button { Name = "MobileGuideSections", Text = Loc.GetString("mobile-guide-sections"),
+            ToggleMode = true, MinHeight = 40, TooltipDelay = float.PositiveInfinity };
+        _sections.OnPressed += _ => { _showNavigation = !Navigation.Visible; InvalidateMeasure(); };
+        AddChild(_sections); AddChild(Navigation); AddChild(Article);
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 available)
+    {
+        var wide = available.X >= 820;
+        var hasNavigation = Navigation.Children.Any(c => c.Visible);
+        _sections.Disabled = !hasNavigation;
+        Navigation.Visible = hasNavigation && (_showNavigation ?? wide);
+        Article.Visible = wide || !Navigation.Visible;
+        _sections.Pressed = Navigation.Visible;
+        _sections.Measure(new Vector2(available.X, 40));
+        var body = Vector2.Max(Vector2.Zero, available - new Vector2(0, 44));
+        var rail = wide && Navigation.Visible ? Math.Clamp(body.X * 0.27f, 200, 300) : 0;
+        Navigation.Measure(new Vector2(wide ? rail : body.X, body.Y));
+        Article.Measure(new Vector2(body.X - rail, body.Y));
+        return Vector2.Zero;
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 size)
+    {
+        var wide = size.X >= 820;
+        var rail = wide && Navigation.Visible ? Math.Clamp(size.X * 0.27f, 200, 300) : 0;
+        _sections.Arrange(UIBox2.FromDimensions(Vector2.Zero, new Vector2(size.X, 40)));
+        var height = MathF.Max(0, size.Y - 44);
+        if (Navigation.Visible) Navigation.Arrange(UIBox2.FromDimensions(new Vector2(0, 44), new Vector2(wide ? rail : size.X, height)));
+        if (Article.Visible) Article.Arrange(UIBox2.FromDimensions(new Vector2(rail, 44), new Vector2(size.X - rail, height)));
+        return size;
+    }
+}
