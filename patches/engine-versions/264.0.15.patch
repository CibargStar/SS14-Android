diff --git a/Robust.Client/UserInterface/Mobile/MobileProfileLayout.cs b/Robust.Client/UserInterface/Mobile/MobileProfileLayout.cs
new file mode 100644
index 0000000..e6208c0
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileProfileLayout.cs
@@ -0,0 +1,230 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// Reflow the server's existing editor; its tabs, fields and actions stay intact.
+internal sealed class MobileProfileBinding : IMobileScreenBinding
+{
+    public Control Source { get; }
+    private readonly Control _left;
+    private readonly bool _leftVisible;
+    private readonly int _leftIndex;
+    private readonly List<MobileWidgetSlot> _slots = new();
+    private readonly MobileWidgetSlot _previewSlot;
+    private readonly TabContainer _tabs;
+    private readonly bool _tabsVisible;
+    private readonly SpriteView _sprite;
+    private readonly Vector2 _spriteMax;
+    private readonly SpriteView.StretchMode _stretch;
+    private readonly MobileProfilePanel _panel;
+    private bool _refreshPreview = true;
+    private long _nextSectionsUpdate;
+
+    public static MobileProfileBinding? TryCreate(Control source)
+    {
+        var all = MobileServerUiAdapter.Tree(source).ToArray();
+        var tabs = all.OfType<TabContainer>().FirstOrDefault(c => c.Name == "TabContainer");
+        var name = all.FirstOrDefault(c => c.Name == "NameEdit");
+        var random = all.FirstOrDefault(c => c.Name == "RandomizeUnlockedButton");
+        var save = all.OfType<Button>().FirstOrDefault(c => c.Name == "SaveButton");
+        var reset = all.OfType<Button>().FirstOrDefault(c => c.Name == "ResetButton");
+        var sprite = all.OfType<SpriteView>().FirstOrDefault(c => c.Name == "SpriteView");
+        if (tabs?.Parent is not BoxContainer left || name == null || random == null || save?.Parent == null || reset?.Parent == null || sprite == null) return null;
+        var top = left.Children.OfType<BoxContainer>().FirstOrDefault(c => MobileServerUiAdapter.Tree(c).Contains(name));
+        if (top == null) return null;
+        Control? Under(Control child, Control parent)
+        {
+            while (child.Parent != null && child.Parent != parent) child = child.Parent;
+            return child.Parent == parent ? child : null;
+        }
+        var identity = Under(name, top); var randomizer = Under(random, top); var files = Under(save, top);
+        var preview = Under(sprite, source);
+        if (identity == null || randomizer == null || files == null || preview == null || identity == randomizer || identity == files || files == randomizer) return null;
+        return new MobileProfileBinding(source, left, tabs, identity, randomizer, files, preview, sprite, save, reset);
+    }
+
+    private MobileProfileBinding(Control source, Control left, TabContainer tabs, Control identity,
+        Control randomizer, Control files, Control preview, SpriteView sprite, Button save, Button reset)
+    {
+        Source = source; _left = left; _tabs = tabs; _sprite = sprite;
+        _leftVisible = left.Visible; _leftIndex = left.GetPositionInParent();
+        _tabsVisible = tabs.TabsVisible; _spriteMax = sprite.MaxSize; _stretch = sprite.Stretch;
+        _panel = new MobileProfilePanel(tabs, sprite);
+        // Snapshot siblings before moving any of them so restore retains order.
+        var identitySlot = new MobileWidgetSlot(identity); var randomSlot = new MobileWidgetSlot(randomizer);
+        var filesSlot = new MobileWidgetSlot(files); var tabsSlot = new MobileWidgetSlot(tabs);
+        var saveSlot = new MobileWidgetSlot(save); var resetSlot = new MobileWidgetSlot(reset);
+        var colors = new List<MobileWidgetSlot>();
+        foreach (var name in new[] { "Skin", "EyeColorPicker" })
+        {
+            var field = MobileServerUiAdapter.Tree(source).FirstOrDefault(c => c.Name == name);
+            if (field?.Parent is BoxContainer group && group.Parent is BoxContainer &&
+                !colors.Any(c => c.Source == group)) colors.Add(new MobileWidgetSlot(group));
+        }
+        _previewSlot = new MobileWidgetSlot(preview);
+        identitySlot.MoveTo(_panel.Identity); randomSlot.MoveTo(_panel.Randomizer); filesSlot.MoveTo(_panel.Files);
+        tabsSlot.MoveTo(_panel.Content);
+        saveSlot.MoveTo(_panel.Footer); resetSlot.MoveTo(_panel.Footer);
+        _previewSlot.MoveTo(_panel.Preview);
+        foreach (var color in colors) color.MoveTo(_panel.ColorFields);
+        _slots.AddRange(colors);
+        _slots.AddRange(new[] { saveSlot, resetSlot, identitySlot, randomSlot, filesSlot, tabsSlot });
+        _tabs.TabsVisible = false;
+        _sprite.Stretch = SpriteView.StretchMode.Fit;
+        save.MinHeight = reset.MinHeight = 40;
+        left.Visible = false;
+        source.AddChild(_panel);
+        _panel.SetPositionFirst();
+    }
+
+    public void Update(Vector2 viewport, float chatHeight)
+    {
+        if (Environment.TickCount64 >= _nextSectionsUpdate)
+        {
+            _nextSectionsUpdate = Environment.TickCount64 + 250;
+            _panel.RefreshSections();
+        }
+        if (_refreshPreview && Source.IsInsideTree && RefreshPreview(Source)) _refreshPreview = false;
+    }
+
+    // The server's preview deliberately deletes its entity on ExitedTree.
+    // Reparenting therefore needs its original public LoadPreview API once.
+    private static bool RefreshPreview(Control source)
+    {
+        var profile = source.GetType().GetField("Profile")?.GetValue(source);
+        if (profile == null) return false;
+        var sprite = MobileServerUiAdapter.Tree(source).FirstOrDefault(c => c.Name == "SpriteView");
+        var method = sprite?.GetType().GetMethods().FirstOrDefault(m => m.Name == "LoadPreview" && m.GetParameters().Length == 3);
+        if (method == null || !method.GetParameters()[0].ParameterType.IsInstanceOfType(profile)) return true;
+        var job = source.GetType().GetField("JobOverride")?.GetValue(source);
+        var clothes = MobileServerUiAdapter.Tree(source).OfType<BaseButton>().FirstOrDefault(c => c.Name == "ShowClothes");
+        method.Invoke(sprite, new[] { profile, job, (object)(clothes?.Pressed ?? true) });
+        return true;
+    }
+
+    public bool OwnsScroll(ScrollContainer scroll)
+    {
+        if (scroll == _panel.Sections.OptionsScroll) return true;
+        for (Control? control = scroll; control != null; control = control.Parent)
+            if (control == _panel) return true;
+        return false;
+    }
+
+    public void Restore()
+    {
+        foreach (var slot in _slots) slot.Restore();
+        _previewSlot.Restore();
+        _panel.Parent?.RemoveChild(_panel);
+        _panel.Dispose();
+        if (!_left.Disposed)
+        {
+            _left.Visible = _leftVisible;
+            if (_left.Parent is { } parent) _left.SetPositionInParent(Math.Min(_leftIndex, parent.ChildCount - 1));
+        }
+        if (!_tabs.Disposed) _tabs.TabsVisible = _tabsVisible;
+        if (!_sprite.Disposed) { _sprite.MaxSize = _spriteMax; _sprite.Stretch = _stretch; }
+        if (!Source.Disposed && Source.IsInsideTree) RefreshPreview(Source);
+    }
+}
+
+internal sealed class MobileProfilePanel : Container
+{
+    public readonly OptionButton Sections = new MobileProfileSectionButton() { Name = "MobileProfileSections", MinHeight = 44 };
+    public readonly ScrollContainer Identity = new() { Name = "MobileProfileIdentity", HScrollEnabled = false };
+    public readonly ScrollContainer Randomizer = new() { Name = "MobileProfileRandomizer", HScrollEnabled = false };
+    public readonly ScrollContainer Files = new() { Name = "MobileProfileFiles", HScrollEnabled = false };
+    public readonly ScrollContainer Colors = new() { Name = "MobileProfileColors", HScrollEnabled = false };
+    public readonly BoxContainer ColorFields = new() { Orientation = BoxContainer.LayoutOrientation.Vertical, SeparationOverride = 8 };
+    public readonly Control Content = new() { Name = "MobileProfileContent" };
+    public readonly PanelContainer Preview = new() { Name = "MobileProfilePreview", StyleClasses = { "BackgroundPanel" } };
+    public readonly BoxContainer Footer = new() { Name = "MobileProfileFooter", SeparationOverride = 6 };
+    private readonly TabContainer _tabs;
+    private readonly SpriteView _sprite;
+    private int _selected;
+    private string _sectionStamp = "";
+
+    public MobileProfilePanel(TabContainer tabs, SpriteView sprite)
+    {
+        Name = "MobileProfilePanel";
+        HorizontalExpand = VerticalExpand = true;
+        RectClipContent = true;
+        _tabs = tabs; _sprite = sprite;
+        Sections.OnItemSelected += e => SelectSection(e.Id);
+        AddChild(Sections); AddChild(Identity); AddChild(Randomizer); AddChild(Files);
+        AddChild(Content); AddChild(Colors); Colors.AddChild(ColorFields); AddChild(Preview); AddChild(Footer);
+        RefreshSections();
+    }
+
+    public void RefreshSections()
+    {
+        var titles = Enumerable.Range(0, _tabs.ChildCount).Select(i => _tabs.GetActualTabTitle(i)).ToArray();
+        var stamp = string.Join("\n", titles.Select((t, i) => t + _tabs.GetTabVisible(i)));
+        if (stamp == _sectionStamp && Sections.ItemCount > 0) return;
+        _sectionStamp = stamp;
+        Sections.Clear();
+        Sections.AddItem(Loc.GetString("mobile-profile-identity"), 0);
+        for (var i = 0; i < titles.Length; i++)
+            if (_tabs.GetTabVisible(i)) Sections.AddItem(titles[i], i + 1);
+        Sections.AddItem(Loc.GetString("mobile-profile-colors"), titles.Length + 1);
+        Sections.AddItem(Loc.GetString("mobile-profile-randomizer"), titles.Length + 2);
+        Sections.AddItem(Loc.GetString("mobile-profile-files"), titles.Length + 3);
+        if (!Sections.TrySelectId(_selected)) _selected = 0;
+        SelectSection(_selected);
+    }
+
+    public void SelectSection(int section)
+    {
+        _selected = section;
+        Sections.SelectId(section);
+        Identity.Visible = section == 0;
+        Content.Visible = section > 0 && section <= _tabs.ChildCount;
+        Colors.Visible = section == _tabs.ChildCount + 1;
+        Randomizer.Visible = section == _tabs.ChildCount + 2;
+        Files.Visible = section == _tabs.ChildCount + 3;
+        if (Content.Visible) _tabs.CurrentTab = section - 1;
+        InvalidateMeasure();
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 available)
+    {
+        var previewWidth = Math.Clamp(available.X * 0.22f, 110, 220);
+        var bodyWidth = MathF.Max(0, available.X - previewWidth - 12);
+        var body = new Vector2(bodyWidth, MathF.Max(0, available.Y - 100));
+        var maxSprite = new Vector2(MathF.Max(1, previewWidth - 20), MathF.Max(1, available.Y - 120));
+        if (_sprite.MaxSize != maxSprite) _sprite.MaxSize = maxSprite;
+        Sections.Measure(new Vector2(bodyWidth, 44));
+        Identity.Measure(body); Content.Measure(body); Colors.Measure(body); Randomizer.Measure(body); Files.Measure(body);
+        Preview.Measure(new Vector2(previewWidth, MathF.Max(0, available.Y - 50)));
+        Footer.Measure(new Vector2(available.X, 44));
+        return Vector2.Zero;
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 size)
+    {
+        var previewWidth = Math.Clamp(size.X * 0.22f, 110, 220);
+        var bodyWidth = MathF.Max(0, size.X - previewWidth - 12);
+        Sections.Arrange(UIBox2.FromDimensions(Vector2.Zero, new Vector2(bodyWidth, 44)));
+        var body = UIBox2.FromDimensions(new Vector2(0, 50), new Vector2(bodyWidth, MathF.Max(0, size.Y - 100)));
+        foreach (var page in new Control[] { Identity, Content, Colors, Randomizer, Files }) if (page.Visible) page.Arrange(body);
+        Preview.Arrange(UIBox2.FromDimensions(new Vector2(bodyWidth + 12, 0), new Vector2(previewWidth, MathF.Max(0, size.Y - 50))));
+        Footer.Arrange(UIBox2.FromDimensions(new Vector2(0, MathF.Max(0, size.Y - 44)), new Vector2(size.X, 44)));
+        return size;
+    }
+}
+
+internal sealed class MobileProfileSectionButton : OptionButton
+{
+    public override void ButtonOverride(Button button)
+    {
+        base.ButtonOverride(button);
+        button.MinHeight = 40;
+        button.ClipText = true;
+        button.TooltipDelay = float.PositiveInfinity;
+    }
+}
