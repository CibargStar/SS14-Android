+    private MobileLobbyServerBinding(Control source, BoxContainer actions, Control info, Control preview)
+    {
+        _preview = preview;
+        var contract = preview.GetType().Assembly.GetTypes().FirstOrDefault(t => t.IsInterface && t.Name == "IClientPreferencesManager");
+        if (contract != null)
+        {
+            _preferences = Robust.Shared.IoC.IoCManager.ResolveType(contract);
+            _preferencesProperty = contract.GetProperty("Preferences");
+        }
+        _body = actions.Parent!; _visible = _body.Visible;
+        _collapse = source.Children.FirstOrDefault(c => c.Name == "CollapseButton");
+        _collapseVisible = _collapse?.Visible ?? false;
+        if (_collapse != null) _collapse.Visible = false;
+        var grid = new GridContainer { Name = "MobileLobbyActions", Columns = 2, HSeparationOverride = 6, VSeparationOverride = 6, VerticalAlignment = Control.VAlignment.Top };
+        var actionPage = new Control(); actionPage.AddChild(grid);
+        var infoPage = new ScrollContainer { HScrollEnabled = false };
+        var infoColumn = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical, SeparationOverride = 6 };
+        infoPage.AddChild(infoColumn);
+        var characterPage = new ScrollContainer { HScrollEnabled = false };
+        var actionSlots = actions.Children.Select(c => new MobileWidgetSlot(c)).ToArray();
+        foreach (var slot in actionSlots)
+        {
+            _slots.Add(slot); slot.MoveTo(grid); slot.Source.MinHeight = 40; slot.Source.VerticalExpand = false;
+        }
+        var fields = new[] { info, _body.Children.FirstOrDefault(c => c.Name == "StationTime"), preview }.Where(c => c != null).Cast<Control>().ToArray();
+        var fieldSlots = fields.Select(c => new MobileWidgetSlot(c)).ToArray();
+        foreach (var slot in fieldSlots)
+        {
+            _slots.Add(slot); slot.MoveTo(slot.Source == preview ? characterPage : infoColumn);
+        }
+        _tabs.AddChild(actionPage); _tabs.AddChild(infoPage); _tabs.AddChild(characterPage);
+        _tabs.SetTabTitle(0, Loc.GetString("mobile-lobby-actions"));
+        _tabs.SetTabTitle(1, Loc.GetString("mobile-lobby-info"));
+        _tabs.SetTabTitle(2, Loc.GetString("mobile-lobby-character"));
+        _body.Visible = false; source.AddChild(_tabs);
+    }
+
+    public void RefreshPreview(bool force = false)
+    {
+        if ((!_previewPending && !force) || _preview.Disposed || !_preview.IsInsideTree) return;
+        if (!force && Environment.TickCount64 < _nextPreview) return;
+        _nextPreview = Environment.TickCount64 + 250;
+        var preferences = _preferencesProperty?.GetValue(_preferences);
+        var profile = preferences?.GetType().GetProperty("SelectedCharacter")?.GetValue(preferences);
+        if (profile == null) return;
+        var sprite = MobileServerUiAdapter.Tree(_preview).FirstOrDefault(c => MobileServerUiAdapter.TypeIs(c, "ProfilePreviewSpriteView"));
+        var load = sprite?.GetType().GetMethods().FirstOrDefault(m => m.Name == "LoadPreview" && m.GetParameters().Length == 3 && m.GetParameters()[0].ParameterType.IsInstanceOfType(profile));
+        load?.Invoke(sprite, new[] { profile, null, (object)true });
+        _previewPending = false;
+    }
+
+    public void Restore()
+    {
+        foreach (var slot in _slots) slot.Restore();
+        if (!_body.Disposed) _body.Visible = _visible;
+        if (_collapse is { Disposed: false }) _collapse.Visible = _collapseVisible;
+        _tabs.Parent?.RemoveChild(_tabs); _tabs.Dispose();
+    }
+}
