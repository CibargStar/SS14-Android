+internal sealed class MobileGuidebookBinding : IMobileScreenBinding
+{
+    public Control Source => _window;
+    private readonly BaseWindow _window;
+    private readonly MobileWidgetSlot _splitSlot, _treeSlot, _articleSlot;
+    private readonly MobileGuidebookPanel _panel;
+    private readonly Vector2 _min, _max, _set, _position;
+    private readonly bool _resizable;
+    private readonly List<(Control Button, Vector2 Minimum)> _buttons = new();
+
+    public MobileGuidebookBinding(BaseWindow window, SplitContainer split)
+    {
+        _window = window;
+        _min = window.MinSize; _max = window.MaxSize; _set = window.SetSize;
+        _position = window.Position; _resizable = window.Resizable;
+        _splitSlot = new MobileWidgetSlot(split);
+        _treeSlot = new MobileWidgetSlot(split.First!);
+        _articleSlot = new MobileWidgetSlot(split.Second!);
+        _panel = new MobileGuidebookPanel();
+        _treeSlot.MoveTo(_panel.Navigation);
+        _articleSlot.MoveTo(_panel.Article);
+        var parent = split.Parent!;
+        var index = split.GetPositionInParent();
+        parent.RemoveChild(split);
+        parent.AddChild(_panel);
+        _panel.SetPositionInParent(index);
+        _window.MinSize = Vector2.Zero;
+        _window.Resizable = false;
+        foreach (var button in MobileServerUiAdapter.Tree(window).Where(c => c.Name is "CloseButton" or "BackButton" or "ForwardButton"))
+        {
+            _buttons.Add((button, button.MinSize));
+            button.MinSize = Vector2.Max(button.MinSize, new Vector2(40));
+        }
+    }
+
+    public void Update(Vector2 viewport, float chatHeight)
+    {
+        var available = _window.Parent?.Size ?? viewport;
+        var size = Vector2.Max(new Vector2(1), available - new Vector2(16));
+        if (_window.MaxSize != size) _window.MaxSize = size;
+        if (_window.SetSize != size) _window.SetSize = size;
+        if (_window.Position != new Vector2(8)) LayoutContainer.SetPosition(_window, new Vector2(8));
+    }
+
+    public bool OwnsScroll(ScrollContainer scroll)
+    {
+        for (Control? control = scroll; control != null; control = control.Parent)
+            if (control == _panel) return true;
+        return false;
+    }
+
+    public void Restore()
+    {
+        foreach (var (button, minimum) in _buttons) if (!button.Disposed) button.MinSize = minimum;
+        _treeSlot.Restore(); _articleSlot.Restore(); _splitSlot.Restore();
+        if (!_window.Disposed)
+        {
+            _window.MinSize = _min; _window.MaxSize = _max; _window.SetSize = _set;
+            _window.Resizable = _resizable;
+            LayoutContainer.SetPosition(_window, _position);
+        }
+        _panel.Parent?.RemoveChild(_panel);
+        _panel.Dispose();
+    }
+}
