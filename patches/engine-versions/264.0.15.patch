+        _expand = all.FirstOrDefault(c => c.Name == "ExpandPanel");
+        _margin = _main?.Margin ?? new Thickness(0); _expandVisible = _expand?.Visible ?? false;
+        _home = MobileLobbyHomeBinding.TryCreate(source);
