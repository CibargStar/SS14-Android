+    public MobileChatMode Mode { get; private set; } = MobileChatMode.Minimal;
+    public bool Expanded => Mode == MobileChatMode.Full;
+    public bool Collapsed => Mode == MobileChatMode.Hidden;
+
+    public bool IsLobby { get; }
+
+    public MobileChatDock(Control content, LineEdit input, bool lobby = false)
+    {
+        Name = "MobileChatDock"; IsLobby = lobby;
+        _content = content;
+        _input = input;
+        MouseFilter = MouseFilterMode.Stop;
+        _visiblePanel = new StyleBoxFlat { BackgroundColor = Color.FromHex("#202128e8"),
+            BorderColor = Color.FromHex("#46485f"), BorderThickness = new Thickness(1) };
+        PanelOverride = _visiblePanel;
+        _column = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical,
+            SeparationOverride = 2 };
+        AddChild(_column);
+        var header = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Horizontal,
+            SeparationOverride = 2 };
+        _column.AddChild(header);
+        header.Visible = !lobby;
+        _hide = new MobileHudIconButton(MobileHudIconButton.Symbol.Chat, "MobileChatToggle",
+            Loc.GetString("mobile-chat-toggle"));
+        _hide.OnPressed += _ => SetCollapsed(!Collapsed);
+        _title = new Label { Text = Loc.GetString("mobile-chat-title"), HorizontalExpand = true,
+            VerticalAlignment = VAlignment.Center, Margin = new Thickness(6, 0) };
+        header.AddChild(_title);
+        _expand = new MobileHudIconButton(MobileHudIconButton.Symbol.Expand, "MobileChatExpand",
+            Loc.GetString("mobile-chat-expand"));
+        _expand.OnPressed += _ => SetMode(Expanded ? MobileChatMode.Minimal : MobileChatMode.Full);
+        header.AddChild(_expand);
+        _expand.SetPositionFirst();
+        header.AddChild(_hide);
+        content.HorizontalExpand = true;
+        content.VerticalExpand = true;
+        _column.AddChild(content);
+        input.OnFocusEnter += InputFocused;
+    }
+
+    private void InputFocused(LineEdit.LineEditEventArgs _) => SetCollapsed(false);
+
+    public void SetCollapsed(bool value) => SetMode(value ? MobileChatMode.Hidden : _lastVisibleMode);
+
+    public void SetMode(MobileChatMode mode)
+    {
+        if (!Enum.IsDefined(mode)) throw new ArgumentOutOfRangeException(nameof(mode));
+        if (IsLobby || Mode == mode) return;
+        if (mode == MobileChatMode.Hidden) _input.ReleaseKeyboardFocus();
+        else _lastVisibleMode = mode;
+        Mode = mode;
+        _content.Visible = !Collapsed;
+        _title.Visible = !Collapsed;
+        _expand.Visible = !Collapsed;
+        _expand.Icon = Expanded ? MobileHudIconButton.Symbol.Compact : MobileHudIconButton.Symbol.Expand;
+        PanelOverride = Collapsed ? _hiddenPanel : _visiblePanel;
+        UpdateLayout();
+    }
+
+    private void UpdateLayout()
+    {
+        InvalidateMeasure();
+        Parent?.InvalidateMeasure();
+        Parent?.InvalidateArrange();
+        LayoutChanged?.Invoke();
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing) _input.OnFocusEnter -= InputFocused;
+        base.Dispose(disposing);
+    }
+
+    public Vector2 DockSize(Vector2 available, float maxWidth = float.PositiveInfinity)
+    {
+        if (IsLobby) return new Vector2(MathF.Min(available.X, maxWidth), MathF.Min(available.Y, Math.Clamp(available.Y * 0.27f, 100, 200)));
+        if (Collapsed) return new Vector2(40);
+        var width = MathF.Min(available.X, Math.Clamp(available.X * (Expanded ? 0.56f : 0.36f), 300, Expanded ? 680 : 460));
+        var height = Expanded ? Math.Clamp(available.Y * 0.62f, 170, 430) : 172;
+        return Vector2.Max(new Vector2(42), new Vector2(MathF.Min(width, maxWidth), MathF.Min(height, available.Y)));
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs b/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs
new file mode 100644
index 0000000..91f1a00
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// ContainerButton retains the active content stylesheet and normal UI input.
+internal sealed class MobileHudIconButton : ContainerButton
+{
+    public enum Symbol { Chat, Send, Expand, Compact, Fold, Unfold }
+    public Symbol Icon { get; set; }
+
+    public MobileHudIconButton(Symbol icon, string name, string tooltip)
+    {
+        Icon = icon;
+        Name = name;
+        ToolTip = tooltip;
+        // Touch controls act on contact. Hover tooltips cannot be used as
+        // an extra interaction step on a phone and must never cover them.
+        TooltipDelay = float.PositiveInfinity;
+        Mode = ActionMode.Press;
+        MinSize = new Vector2(40);
+    }
+
+    protected internal override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+        var size = PixelSize;
+        var centre = (Vector2)size / 2;
+        var unit = MathF.Min(size.X, size.Y) * 0.23f;
+        var color = Disabled ? new Color(0.4f, 0.4f, 0.5f) : Color.FromHex("#b5c4d2");
+        void Line(float x1, float y1, float x2, float y2) => handle.DrawLine(
+            centre + new Vector2(x1, y1) * unit, centre + new Vector2(x2, y2) * unit, color);
+        switch (Icon)
+        {
+            case Symbol.Chat:
+                Line(-1, -0.8f, 1, -0.8f); Line(1, -0.8f, 1, 0.6f);
+                Line(1, 0.6f, -0.4f, 0.6f); Line(-0.4f, 0.6f, -1, 1);
+                Line(-1, 1, -1, -0.8f); Line(-0.6f, -0.2f, 0.6f, -0.2f);
+                break;
+            case Symbol.Send:
+                Line(-1, -0.8f, 1, 0); Line(1, 0, -1, 0.8f);
+                Line(-1, 0.8f, -0.5f, 0); Line(-0.5f, 0, -1, -0.8f); Line(-0.5f, 0, 1, 0);
+                break;
+            case Symbol.Expand:
+                Line(-1, -0.3f, -1, -1); Line(-1, -1, -0.3f, -1);
+                Line(1, 0.3f, 1, 1); Line(1, 1, 0.3f, 1);
+                Line(-1, -1, -0.2f, -0.2f); Line(1, 1, 0.2f, 0.2f);
+                break;
+            case Symbol.Compact:
+                Line(-1, -0.3f, -0.3f, -0.3f); Line(-0.3f, -0.3f, -0.3f, -1);
+                Line(1, 0.3f, 0.3f, 0.3f); Line(0.3f, 0.3f, 0.3f, 1);
+                break;
+            case Symbol.Fold:
+                Line(0.5f, -0.8f, -0.5f, 0); Line(-0.5f, 0, 0.5f, 0.8f);
+                break;
+            case Symbol.Unfold:
+                Line(-0.5f, -0.8f, 0.5f, 0); Line(0.5f, 0, -0.5f, 0.8f);
+                break;
+        }
+    }
+}
