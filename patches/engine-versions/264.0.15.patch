diff --git a/Robust.Client/UserInterface/Mobile/MobileDebugWindow.cs b/Robust.Client/UserInterface/Mobile/MobileDebugWindow.cs
new file mode 100644
index 0000000..413d99a
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileDebugWindow.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Diagnostics;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+using Robust.Shared.Timing;
+using Stopwatch = System.Diagnostics.Stopwatch;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public sealed class MobileDebugWindow : DefaultWindow
+{
+    private readonly Label _fps = new();
+    private readonly Label _cpu = new();
+    private readonly Label _memory = new();
+    private readonly Label _managed = new();
+    private readonly Label _system = new();
+    private readonly Process _process = Process.GetCurrentProcess();
+    private long _started = Stopwatch.GetTimestamp();
+    private int _frames;
+    private double? _lastCpu;
+
+    public MobileDebugWindow(Vector2 available)
+    {
+        Title = "Debug";
+        MaxSize = Vector2.Max(new Vector2(160, 120), available - new Vector2(24));
+        MinSize = Vector2.Min(MaxSize, new Vector2(380, 230));
+        var column = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical,
+            SeparationOverride = 8, Margin = new Robust.Shared.Maths.Thickness(12) };
+        foreach (var label in new[] { _fps, _cpu, _memory, _managed, _system }) column.AddChild(label);
+        Contents.AddChild(column);
+        _fps.Text = "FPS / кадр: сбор данных…";
+        _cpu.Text = "CPU игры: сбор данных…";
+        ReadUsage(0);
+    }
+
+    protected override void FrameUpdate(FrameEventArgs args)
+    {
+        base.FrameUpdate(args);
+        if (!VisibleInTree) return;
+        _frames++;
+        var sampledAt = Stopwatch.GetTimestamp();
+        var seconds = Stopwatch.GetElapsedTime(_started, sampledAt).TotalSeconds;
+        if (seconds < 1) return;
+        _fps.Text = $"FPS: {_frames / seconds:F1}   Кадр: {seconds * 1000 / _frames:F1} мс";
+        ReadUsage(seconds);
+        _frames = 0;
+        _started = sampledAt;
+    }
+
+    private void ReadUsage(double seconds)
+    {
+        _managed.Text = $"Память .NET: {GC.GetTotalMemory(false) / 1048576d:F0} МиБ";
+        try
+        {
+            var provider = AppDomain.CurrentDomain.GetData("SS14_ANDROID_METRICS") as Func<double[]>;
+            var sample = provider?.Invoke();
+            if (sample != null && sample.Length != 5) throw new InvalidOperationException("Invalid resource sample.");
+            var cpu = sample?[0] ?? _process.TotalProcessorTime.TotalMilliseconds;
+            var cores = Math.Max(1, sample?[4] ?? Environment.ProcessorCount);
+            if (_lastCpu is { } previous && seconds > 0)
+                _cpu.Text = $"CPU игры: {Math.Clamp((cpu - previous) / (seconds * 10 * cores), 0, 100):F1}% от {cores:F0} ядер";
+            _lastCpu = cpu;
+            if (sample != null)
+            {
+                _memory.Text = $"Память игры (PSS): {sample[1] / 1048576:F0} МиБ";
+                _system.Text = $"Свободно RAM: {sample[2] / 1073741824:F1} / {sample[3] / 1073741824:F1} ГиБ";
+            }
+            else
+            {
+                _process.Refresh();
+                _memory.Text = $"Память процесса (RSS): {_process.WorkingSet64 / 1048576d:F0} МиБ";
+                _system.Text = "RAM системы: нет данных";
+            }
+        }
+        catch (Exception)
+        {
+            _cpu.Text = "CPU игры: нет данных";
+            _memory.Text = "Память процесса: нет данных";
+            _system.Text = "RAM системы: нет данных";
+        }
+    }
+
+    protected override void ExitedTree()
+    {
+        base.ExitedTree();
+        _process.Dispose();
+    }
+}
