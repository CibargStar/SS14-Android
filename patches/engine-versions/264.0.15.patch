+    private readonly bool _visible;
+    private readonly Control? _collapse;
+    private readonly bool _collapseVisible;
+    private readonly TabContainer _tabs = new() { Name = "MobileLobbyServerPages" };
+    private readonly Control _preview;
+    private bool _previewPending = true;
+    private long _nextPreview;
+    private readonly object? _preferences;
+    private readonly System.Reflection.PropertyInfo? _preferencesProperty;
+
+    public static MobileLobbyServerBinding? TryCreate(Control source)
+    {
+        var all = MobileServerUiAdapter.Tree(source).ToArray();
+        var help = all.FirstOrDefault(c => c.Name == "AHelpButton");
+        var info = all.FirstOrDefault(c => c.Name == "ServerInfo");
+        var preview = all.FirstOrDefault(c => c.Name == "CharacterPreview");
+        if (info is null || preview is null || help?.Parent is not BoxContainer actions || info.Parent != actions.Parent || preview.Parent != actions.Parent || actions.Parent == null) return null;
+        return new MobileLobbyServerBinding(source, actions, info, preview);
