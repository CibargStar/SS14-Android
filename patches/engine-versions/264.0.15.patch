@@ -0,0 +1,45 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+internal sealed class MobileMenuStrip : BoxContainer
+{
+    private readonly GridContainer _icons;
+    private readonly MobileHudIconButton _toggle;
+    public bool Collapsed { get; private set; }
+
+    public MobileMenuStrip()
+    {
+        Name = "MobileMenuStrip";
+        SeparationOverride = 4;
+        VerticalAlignment = VAlignment.Top;
+        _toggle = new MobileHudIconButton(MobileHudIconButton.Symbol.Fold, "MobileMenuToggle",
+            Loc.GetString("mobile-menu-toggle")) { VerticalAlignment = VAlignment.Top };
+        _toggle.OnPressed += _ => SetCollapsed(!Collapsed);
+        AddChild(_toggle);
+        _icons = new GridContainer { Name = "MobileMenuIcons", Columns = 7,
+            HSeparationOverride = 4, VSeparationOverride = 4 };
+        AddChild(_icons);
+    }
+
+    public void AddButton(Control button) => _icons.AddChild(button);
+    public void SetCollapsed(bool value)
+    {
+        Collapsed = value;
+        _icons.Visible = !value;
+        _toggle.Icon = value ? MobileHudIconButton.Symbol.Unfold : MobileHudIconButton.Symbol.Fold;
+        InvalidateMeasure();
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 availableSize)
+    {
+        var width = Root == null ? availableSize.X : MathF.Min(availableSize.X, Root.Size.X * 0.48f);
+        _icons.Columns = Math.Clamp((int)((width - 44) / 48), 1, 7);
+        return base.MeasureOverride(availableSize);
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs b/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs
new file mode 100644
index 0000000..c23fd20
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs
@@ -0,0 +1,479 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+using Robust.Shared.Map;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// Adapt live upstream/server widgets, not Content DLLs or their networking.
+// Sources remain in their screen so controller/widget lookup keeps working.
+internal sealed class MobileServerUiAdapter : Control
+{
+    private readonly Control _screenRoot;
+    private readonly Control _stateRoot;
+    private readonly Control _windowRoot;
+    private readonly List<IMobileScreenBinding> _screens = new();
+    private readonly List<ChatBinding> _chats = new();
+    private readonly List<MenuBinding> _menus = new();
+    private float _scanIn;
+    private int _layoutStamp;
+    private readonly Dictionary<long, (Control Scroll, Vector2 Start, Vector2 Last, bool Dragging)> _scrolls = new();
+
+    public MobileServerUiAdapter(Control screenRoot, Control stateRoot, Control windowRoot)
+    {
+        Name = "MobileServerUiAdapter";
+        _screenRoot = screenRoot;
+        _stateRoot = stateRoot;
+        _windowRoot = windowRoot;
+        MouseFilter = MouseFilterMode.Ignore;
+    }
+
+    internal static IEnumerable<Control> Tree(Control control)
+    {
+        yield return control;
+        foreach (var child in control.Children)
+            foreach (var nested in Tree(child)) yield return nested;
+    }
+
+    internal static bool TypeIs(Control control, string name)
+    {
+        for (var type = control.GetType(); type != null; type = type.BaseType)
+            if (type.Name == name) return true;
+        return false;
+    }
+
+    public void Update(float delta)
+    {
+        foreach (var screen in _screens.ToArray())
+            if (!screen.Source.IsInsideTree || screen.Source.Disposed)
+            {
+                screen.Restore();
+                _screens.Remove(screen);
+            }
+        foreach (var chat in _chats.ToArray())
+            if (!chat.Source.IsInsideTree || chat.Source.Disposed)
+            {
+                chat.Restore();
+                _chats.Remove(chat);
+                InvalidateMeasure();
+            }
+        foreach (var menu in _menus.ToArray())
+            if (!menu.Source.IsInsideTree || menu.Source.Disposed)
+            {
+                menu.Restore();
+                _menus.Remove(menu);
+            }
+        _scanIn -= delta;
+        if (_scanIn <= 0)
+        {
+            _scanIn = 0.25f;
+            // Snapshot before changing child collections. Check base type names
+            // and original named controls; no dependency on a fork namespace.
+            var controls = Tree(_screenRoot).Concat(Tree(_stateRoot)).Concat(Tree(_windowRoot)).ToArray();
+            foreach (var source in controls)
+            {
+                // Never adapt our own presentation containers recursively.
+                if (source.GetType().Assembly == typeof(Control).Assembly) continue;
+                if ((TypeIs(source, "LobbyGui") || TypeIs(source, "GuidebookWindow") || TypeIs(source, "CharacterSetupGui") || TypeIs(source, "HumanoidProfileEditor") || TypeIs(source, "LateJoinGui")) && !_screens.Any(s => s.Source == source))
+                {
+                    var split = Tree(source).OfType<SplitContainer>().FirstOrDefault();
+                    if (TypeIs(source, "LobbyGui") && split?.First?.Name == "LeftSide" && split.Second?.Name == "RightSide")
+                        _screens.Add(new MobileLobbyBinding(source, split));
+                    else if (source is BaseWindow lateJoin && TypeIs(source, "LateJoinGui"))
+                        _screens.Add(new MobileLateJoinBinding(lateJoin));
+                    else if (source is BaseWindow window && TypeIs(source, "GuidebookWindow") && split?.First?.Name == "TreeBox" && split.Second != null)
+                        _screens.Add(new MobileGuidebookBinding(window, split));
+                    else if (TypeIs(source, "HumanoidProfileEditor") && MobileProfileBinding.TryCreate(source) is { } profile)
+                        _screens.Add(profile);
+                    else if (TypeIs(source, "CharacterSetupGui"))
+                    {
+                        var editor = Tree(source).FirstOrDefault(c => c.Name == "CharEditor");
+                        if (editor?.Parent is BoxContainer body && body.Children.OfType<ScrollContainer>()
+                            .FirstOrDefault(c => Tree(c).Any(n => n.Name == "Characters")) is { } picker)
+                            _screens.Add(new MobileCharacterBinding(source, body, picker, editor));
+                    }
+                }
+                if ((TypeIs(source, "ChatBox") || source.Children.Any(c => c.Name == "ChatWindowPanel")) && !_chats.Any(c => c.Source == source))
+                    AttachChat(source);
+                if ((TypeIs(source, "GameTopMenuBar") || source.Children.Any(c => TypeIs(c, "MenuButton"))) && !_menus.Any(m => m.Source == source))
+                    AttachMenu(source);
+            }
+        }
+        foreach (var chat in _chats)
+        {
+            chat.Source.Visible = !chat.Dock.Collapsed;
+            chat.Dock.Visible = chat.Lobby == null ? AncestorsVisible(chat.OriginalParent) :
+                chat.Lobby.VisibleInTree && !Tree(chat.Lobby).Any(c => c.Name == "CharacterSetupState" && c.Visible);
+        }
+        foreach (var menu in _menus) menu.Enforce();
+        foreach (var screen in _screens)
+            screen.Update(Root?.Size ?? Size, _chats.Where(c => !c.Dock.Collapsed)
+                .Select(c => c.Dock.DockSize(Root?.Size ?? Size).Y).DefaultIfEmpty(0).Max());
+        var layout = new HashCode();
+        foreach (var control in _menus.Select(m => m.Source))
+        {
+            layout.Add(control.VisibleInTree); layout.Add(control.GlobalPosition); layout.Add(control.Size);
+        }
+        foreach (var lobby in _screens.OfType<MobileLobbyBinding>())
+        {
+            layout.Add(lobby.ChatLayout.Position); layout.Add(lobby.ChatLayout.Size);
+        }
+        var stamp = layout.ToHashCode();
+        if (stamp != _layoutStamp) { _layoutStamp = stamp; InvalidateMeasure(); InvalidateArrange(); }
+    }
+
+    private static bool AncestorsVisible(Control? control)
+    {
+        while (control != null)
+        {
+            if (!control.Visible) return false;
+            control = control.Parent;
+        }
+        return true;
+    }
+
+    private void AttachChat(Control source)
+    {
+        var controls = Tree(source).ToArray();
+        var panel = controls.FirstOrDefault(c => c.Name == "ChatWindowPanel");
+        var input = controls.OfType<LineEdit>().FirstOrDefault(c => c.Name == "Input");
+        var output = controls.OfType<OutputPanel>().FirstOrDefault();
+        if (panel?.Parent == null || input?.Parent == null || output == null) return;
+        // Require the original channel/filter controls; never replace an
+        // unrelated text field or bypass server permission/channel handling.
+        if (!controls.Any(c => c.Name == "ChannelSelector") || !controls.Any(c => c.Name == "FilterButton")) return;
+        var binding = new ChatBinding(source, input, output);
+        _chats.Add(binding);
+        binding.Dock.LayoutChanged += () => { InvalidateMeasure(); InvalidateArrange(); };
+        InvalidateMeasure();
+    }
+
+    private void AttachMenu(Control source)
+    {
+        var buttons = source.Children.Where(c => TypeIs(c, "MenuButton")).ToArray();
+        if (buttons.Length == 0) return;
+        _menus.Add(new MenuBinding(source, buttons));
+    }
+
+    public bool HandleTouch(TouchFingerEventArgs args, Control? hit, Action<long> cancelClick)
+    {
+        var id = args.FingerId;
+        var position = args.Coordinates.Position;
+        if (args.Action == TouchFingerAction.Down)
+        {
+            _scrolls.Remove(id);
+            for (var control = hit; control != null; control = control.Parent)
+            {
+                // Native editors, sliders and scrollbars keep their own drag.
+                if (control is Controls.Range or LineEdit or TextEdit) return false;
+                var output = control as OutputPanel;
+                var scroll = control as ScrollContainer;
+                if (!(output != null && _chats.Any(c => c.Output == output)) &&
+                    !(scroll != null && _screens.Any(s => s.OwnsScroll(scroll)))) continue;
+                _scrolls[id] = (control, position, position, false);
+                return true;
+            }
+            return false;
+        }
+        if (!_scrolls.TryGetValue(id, out var state)) return false;
+        if (args.Action != TouchFingerAction.Motion || !state.Scroll.VisibleInTree)
+        {
+            _scrolls.Remove(id);
+            if (!state.Dragging && args.Action == TouchFingerAction.Up && state.Scroll.VisibleInTree)
+            {
+                // Chat links activate on mouse-down. Delay the entire click
+                // until a real tap is known; a history swipe must never fire it.
+                var inOutput = false;
+                for (var control = hit; control != null; control = control.Parent) inOutput |= control == state.Scroll;
+                if (inOutput && args.EmitMouse is { } emit)
+                {
+                    emit(TouchMouseAction.Move, args.Coordinates);
+                    emit(TouchMouseAction.Down, args.Coordinates);
+                    emit(TouchMouseAction.Up, args.Coordinates);
+                }
+            }
+            return true;
+        }
+        var dragging = state.Dragging || Vector2.Distance(args.Coordinates.Position, state.Start) >= 10 * UIScale;
+        if (dragging)
+        {
+            if (!state.Dragging) cancelClick(id);
+            var delta = position - (state.Dragging ? state.Last : state.Start);
+            if (state.Scroll is OutputPanel output) output.ScrollByDelta(delta.Y);
+            else if (state.Scroll is ScrollContainer scroll)
+            {
+                if (scroll.VScrollEnabled) scroll.VScrollTarget -= delta.Y / UIScale;
+                if (scroll.HScrollEnabled) scroll.HScrollTarget -= delta.X / UIScale;
+            }
+        }
+        _scrolls[id] = (state.Scroll, state.Start, position, dragging);
+        return true;
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 availableSize)
+    {
+        foreach (var chat in _chats) chat.Dock.Measure(chat.Dock.DockSize(availableSize));
+        return Vector2.Zero;
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        var top = 0f;
+        foreach (var chat in _chats)
+        {
+            if (chat.Dock.IsLobby)
+            {
+                var binding = _screens.OfType<MobileLobbyBinding>().FirstOrDefault(s => s.Source == chat.Lobby);
+                var layout = binding?.ChatLayout;
+                var lobbySize = layout?.Size ?? chat.Dock.DockSize(finalSize);
+                var bottom = (layout?.Position ?? new Vector2(finalSize.X - lobbySize.X, finalSize.Y - lobbySize.Y)) - (chat.Dock.Parent?.GlobalPosition ?? Vector2.Zero);
+                LayoutContainer.SetMarginLeft(chat.Dock, bottom.X); LayoutContainer.SetMarginTop(chat.Dock, bottom.Y);
+                LayoutContainer.SetMarginRight(chat.Dock, bottom.X + lobbySize.X); LayoutContainer.SetMarginBottom(chat.Dock, bottom.Y + lobbySize.Y);
+                chat.Dock.Measure(lobbySize); chat.Dock.Arrange(UIBox2.FromDimensions(bottom, lobbySize));
+                continue;
+            }
+            var desired = chat.Dock.DockSize(finalSize);
+            var left = 12f;
+            var right = finalSize.X;
+            foreach (var menu in _menus)
+                if (menu.Source.VisibleInTree && menu.Source.GlobalPosition.X < finalSize.X / 2 && menu.Source.GlobalPosition.Y < top + desired.Y)
+                    left = MathF.Max(left, menu.Source.GlobalPosition.X + menu.Source.Size.X + 12);
+            if (!chat.Dock.Collapsed && Root != null)
+            {
+                var settings = Tree(Root).FirstOrDefault(control => control.Name == "MobileDisplayButton");
+                if (settings is { VisibleInTree: true } && settings.GlobalPosition.Y < top + desired.Y)
+                    left = MathF.Max(left, settings.GlobalPosition.X + settings.Size.X + 8);
+            }
+            var size = chat.Dock.DockSize(finalSize, MathF.Max(42, right - left));
+            chat.Dock.Measure(size);
+            var global = new Vector2(MathF.Max(left, right - size.X), top);
+            var position = global - (chat.Dock.Parent?.GlobalPosition ?? Vector2.Zero);
+            LayoutContainer.SetMarginLeft(chat.Dock, position.X);
+            LayoutContainer.SetMarginTop(chat.Dock, position.Y);
+            LayoutContainer.SetMarginRight(chat.Dock, position.X + size.X);
+            LayoutContainer.SetMarginBottom(chat.Dock, position.Y + size.Y);
+            chat.Dock.Arrange(UIBox2.FromDimensions(position, size));
+            top += size.Y + 6;
+        }
+        return finalSize;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+        {
+            foreach (var chat in _chats) chat.Restore();
+            foreach (var menu in _menus) menu.Restore();
+            foreach (var screen in _screens) screen.Restore();
+            _chats.Clear(); _menus.Clear(); _screens.Clear();
+            _scrolls.Clear();
+        }
+        base.Dispose(disposing);
+    }
+
+    private sealed class ChatBinding
+    {
+        public readonly Control Source;
+        public readonly MobileChatDock Dock;
+        public readonly OutputPanel Output;
+        public readonly Control OriginalParent;
+        public readonly Control? Lobby;
+        private readonly UIScreen? _screen;
+        private readonly int _index;
+        private readonly bool _visible;
+        private readonly Vector2 _minimum;
+        private readonly Vector2 _setSize;
+        private readonly Vector2 _maximum;
+        private readonly (AttachedProperty Property, float Value)[] _margins;
+        private readonly LineEdit _input;
+        private readonly string? _placeholder;
+        private readonly Vector2 _inputMin;
+        private readonly MobileHudIconButton _send;
+
+        public ChatBinding(Control source, LineEdit input, OutputPanel output)
+        {
+            Source = source; Output = output; _input = input;
+            OriginalParent = source.Parent!; _index = source.GetPositionInParent(); _visible = source.Visible;
+            _minimum = source.MinSize; _setSize = source.SetSize; _maximum = source.MaxSize;
+            _margins = new[] { LayoutContainer.MarginLeftProperty, LayoutContainer.MarginTopProperty,
+                LayoutContainer.MarginRightProperty, LayoutContainer.MarginBottomProperty }
+                .Select(property => (property, source.GetValue<float>(property))).ToArray();
+            _placeholder = input.PlaceHolder; _inputMin = input.MinSize;
+            for (var parent = source.Parent; parent != null; parent = parent.Parent)
+                if (parent is UIScreen screen) { _screen = screen; break; }
+            // Public upstream registration API handles nested/separated layouts.
+            if (_screen != null && source is UIWidget && _screen[source.GetType()] == source)
+                typeof(UIScreen).GetMethod(nameof(UIScreen.RemoveWidget))!.MakeGenericMethod(source.GetType()).Invoke(_screen, null);
+            source.Parent?.RemoveChild(source);
+            source.MinSize = Vector2.Zero; source.SetSize = new Vector2(float.NaN); source.MaxSize = new Vector2(float.PositiveInfinity);
+            for (var ancestor = OriginalParent; ancestor != null; ancestor = ancestor.Parent)
+                if (TypeIs(ancestor, "LobbyGui")) { Lobby = ancestor; break; }
+            Dock = new MobileChatDock(source, input, Lobby != null);
+            var parentControl = (Control?) _screen ?? OriginalParent;
+            parentControl.AddChild(Dock);
+            LayoutContainer.SetAnchorPreset(Dock, LayoutContainer.LayoutPreset.TopLeft);
+            input.PlaceHolder = Loc.GetString("mobile-chat-placeholder");
+            input.MinHeight = MathF.Max(38, input.MinHeight);
+            _send = new MobileHudIconButton(MobileHudIconButton.Symbol.Send, "MobileChatSend", Loc.GetString("mobile-chat-send"));
+            _send.OnPressed += _ => input.ForceSubmitText();
+            input.Parent!.AddChild(_send);
+        }
+
+        public void Restore()
+        {
+            _send.Dispose();
+            if (!_input.Disposed) { _input.PlaceHolder = _placeholder; _input.MinSize = _inputMin; }
+            // Detach the dock with the source inside so UIScreen unregisters
+            // its widgets before they are put back at their original location.
+            Dock.Parent?.RemoveChild(Dock);
+            if (!Source.Disposed)
+            {
+                Source.Parent?.RemoveChild(Source);
+                Source.MinSize = _minimum; Source.SetSize = _setSize; Source.MaxSize = _maximum; Source.Visible = _visible;
+                foreach (var item in _margins) Source.SetValue(item.Property, item.Value);
+                if (!OriginalParent.Disposed)
+                {
+                    OriginalParent.AddChild(Source);
+                    Source.SetPositionInParent(Math.Min(_index, OriginalParent.ChildCount - 1));
+                    if (_screen != null && !_screen.Disposed && Source is UIWidget widget && _screen[Source.GetType()] == null)
+                        _screen.AddWidgetDirect(widget);
+                }
+                else Source.Dispose();
+            }
+            Dock.Dispose();
+        }
+    }
+
+    private sealed class IconLayout
+    {
+        private readonly TextureRect _icon;
+        private readonly Control _button;
+        private readonly Control _parent;
+        private readonly int _index;
+        private readonly bool _shrink;
+        private readonly Vector2 _scale, _size, _minimum;
+        private readonly Thickness _margin;
+        private readonly HAlignment _horizontal;
+        private readonly VAlignment _vertical;
+        private readonly TextureRect.StretchMode _stretch;
+        private readonly MouseFilterMode _mouseFilter;
+        private Vector2 _centeringOffset;
+
+        public IconLayout(TextureRect icon, Control button)
+        {
+            _icon = icon; _button = button; _parent = icon.Parent!; _index = icon.GetPositionInParent();
+            _shrink = icon.CanShrink; _scale = icon.TextureScale; _size = icon.SetSize; _minimum = icon.MinSize;
+            _margin = icon.Margin; _horizontal = icon.HorizontalAlignment; _vertical = icon.VerticalAlignment;
+            _stretch = icon.Stretch; _mouseFilter = icon.MouseFilter;
+        }
+
+        public void Center()
+        {
+            _parent.RemoveChild(_icon);
+            _button.AddChild(_icon);
+            Enforce();
+        }
+
+        public void Enforce()
+        {
+            // Original end-cap skins can have asymmetric content padding.
+            // Use the last arranged geometry even when an ancestor is queued
+            // for layout, then compensate the icon without changing the skin.
+            if (_button.Size.X > 0 && _button.Size.Y > 0 && _icon.Size.X > 0 && _icon.Size.Y > 0)
+            {
+                var delta = _button.Size / 2 - (_icon.Position + _icon.Size / 2);
+                if (delta.LengthSquared() > 0.0001f) _centeringOffset += delta;
+            }
+            if (!_icon.CanShrink) _icon.CanShrink = true;
+            if (_icon.MinSize != Vector2.Zero) _icon.MinSize = Vector2.Zero;
+            if (_icon.SetSize != new Vector2(24)) _icon.SetSize = new Vector2(24);
+            var margin = new Thickness(_centeringOffset.X, _centeringOffset.Y, -_centeringOffset.X, -_centeringOffset.Y);
+            if (!_icon.Margin.Equals(margin)) _icon.Margin = margin;
+            if (_icon.HorizontalAlignment != HAlignment.Center) _icon.HorizontalAlignment = HAlignment.Center;
+            if (_icon.VerticalAlignment != VAlignment.Center) _icon.VerticalAlignment = VAlignment.Center;
+            if (_icon.Stretch != TextureRect.StretchMode.KeepAspectCentered) _icon.Stretch = TextureRect.StretchMode.KeepAspectCentered;
+            _icon.MouseFilter = MouseFilterMode.Ignore;
+        }
+
+        public void Restore()
+        {
+            if (_icon.Disposed) return;
+            _icon.Parent?.RemoveChild(_icon);
+            _icon.CanShrink = _shrink; _icon.TextureScale = _scale; _icon.SetSize = _size; _icon.MinSize = _minimum;
+            _icon.Margin = _margin; _icon.HorizontalAlignment = _horizontal; _icon.VerticalAlignment = _vertical;
+            _icon.Stretch = _stretch; _icon.MouseFilter = _mouseFilter;
+            if (!_parent.Disposed)
+            {
+                _parent.AddChild(_icon);
+                _icon.SetPositionInParent(Math.Min(_index, _parent.ChildCount - 1));
+            }
+            else _icon.Dispose();
+        }
+    }
+
+    private sealed class MenuBinding
+    {
+        public readonly Control Source;
+        private readonly MobileMenuStrip _strip = new();
+        private readonly List<(Control Button, int Index, Vector2 Min, Vector2 Set)> _buttons = new();
+        private readonly List<(Control Label, bool Visible)> _labels = new();
+        private readonly List<IconLayout> _icons = new();
+        private readonly Vector2 _min;
+        private readonly Thickness _margin;
+
+        public MenuBinding(Control source, Control[] buttons)
+        {
+            Source = source; _min = source.MinSize; _margin = source.Margin;
+            foreach (var button in buttons)
+            {
+                _buttons.Add((button, button.GetPositionInParent(), button.MinSize, button.SetSize));
+                foreach (var label in Tree(button).OfType<Label>()) _labels.Add((label, label.Visible));
+                foreach (var icon in Tree(button).OfType<TextureRect>().ToArray())
+                {
+                    var layout = new IconLayout(icon, button);
+                    _icons.Add(layout);
+                    layout.Center();
+                }
+            }
+            foreach (var button in buttons) { source.RemoveChild(button); _strip.AddButton(button); }
+            source.AddChild(_strip);
+            Enforce();
+        }
+
+        public void Enforce()
+        {
+            if (Source.MinSize != Vector2.Zero) Source.MinSize = Vector2.Zero;
+            if (!Source.Margin.Equals(_margin)) Source.Margin = _margin;
+            foreach (var item in _buttons)
+            {
+                if (item.Button.MinSize != new Vector2(40)) item.Button.MinSize = new Vector2(40);
+                if (item.Button.SetSize != new Vector2(40)) item.Button.SetSize = new Vector2(40);
+            }
+            foreach (var item in _labels) item.Label.Visible = false;
+            foreach (var item in _icons) item.Enforce();
+        }
+
+        public void Restore()
+        {
+            foreach (var item in _labels) if (!item.Label.Disposed) item.Label.Visible = item.Visible;
+            foreach (var item in _icons) item.Restore();
+            foreach (var item in _buttons)
+            {
+                if (item.Button.Disposed) continue;
+                item.Button.Parent?.RemoveChild(item.Button);
+                item.Button.MinSize = item.Min; item.Button.SetSize = item.Set;
+                if (!Source.Disposed) { Source.AddChild(item.Button); item.Button.SetPositionInParent(Math.Min(item.Index, Source.ChildCount - 1)); }
+                else item.Button.Dispose();
+            }
+            if (!Source.Disposed) { Source.MinSize = _min; Source.Margin = _margin; }
+            _strip.Dispose();
+        }
+    }
+}
