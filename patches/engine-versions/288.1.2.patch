+        _editorBarContainer.Visible = IsEditMode;
+        _editButton.Text = IsEditMode ? "DONE" : "EDIT";
+
+        _thumbstick.IsEditMode = IsEditMode;
+        foreach (var btn in _allButtons)
+        {
+            btn.IsEditMode = IsEditMode;
+        }
+
+        if (!IsEditMode)
+        {
+            _currentlyDraggingControl = null;
+            _dragTouchOffset = null;
+            CloseModalDialog();
+            SaveLayout();
+        }
+
+        InvalidateArrange();
+    }
+
+    private void AdjustScale(float delta)
+    {
+        var current = _cfg.GetCVar(CVars.MobileControlsScale);
+        var updated = Math.Clamp(current + delta, 0.6f, 3.0f);
+        _cfg.SetCVar(CVars.MobileControlsScale, updated);
+        UpdateStyling();
+        InvalidateArrange();
+    }
+
+    private void ResetToDefaultLayout()
+    {
+        _cfg.SetCVar(CVars.MobileControlsLayout, string.Empty);
+        _savedPositions.Clear();
+        _savedSizes.Clear();
+        _deletedButtonIds.Clear();
+
+        for (int i = _allButtons.Count - 1; i >= 0; i--)
+        {
+            var btn = _allButtons[i];
+            if (btn.IsCustom)
+            {
+                _allButtons.RemoveAt(i);
+                _clusterContainer.RemoveChild(btn);
+            }
+        }
+
+        foreach (var defBtn in _defaultButtons)
+        {
+            if (!_allButtons.Contains(defBtn))
+            {
+                _allButtons.Add(defBtn);
+                _clusterContainer.AddChild(defBtn);
+            }
+            defBtn.CustomPosition = null;
+            defBtn.CustomSize = null;
+            defBtn.IsEditMode = IsEditMode;
+        }
+
+        _thumbstick.CustomPosition = null;
+        InvalidateArrange();
+    }
+
+    private void ToggleControlsVisibility()
+    {
+        _controlsHidden = !_controlsHidden;
+        _clusterContainer.Visible = !_controlsHidden;
+        _editButton.Visible = !_controlsHidden;
+        _hideButton.Text = _controlsHidden ? "SHOW" : "HIDE";
+
+        if (_controlsHidden)
+        {
+            _thumbstick.ReleaseStick();
+            foreach (var btn in _allButtons)
+            {
+                btn.Release();
+            }
+        }
+    }
+
+    public bool HandleTouch(TouchFingerEventArgs args)
+    {
+        if (!VisibleInTree)
+            return false;
+
+        if (_modalOverlay.Visible || IsEditMode)
+            return false;
+
+        switch (args.Action)
+        {
+            case TouchFingerAction.Down:
+            {
+                var stickPos = args.Coordinates.Position / _thumbstick.UIScale - _thumbstick.GlobalPosition;
+                if (_thumbstick.VisibleInTree && _thumbstick.HasPoint(stickPos))
+                {
+                    _claimedTouches[args.FingerId] = _thumbstick;
+                    _thumbstick.OnTouchDown(args.FingerId, stickPos);
+                    return true;
+                }
+
+                for (int i = _allButtons.Count - 1; i >= 0; i--)
+                {
+                    var btn = _allButtons[i];
+                    var btnPos = args.Coordinates.Position / btn.UIScale - btn.GlobalPosition;
+                    if (btn.VisibleInTree && btn.HasPoint(btnPos))
+                    {
+                        _claimedTouches[args.FingerId] = btn;
+                        btn.OnTouchDown(args.FingerId);
+                        return true;
+                    }
+                }
+
+                PojavActionButton[] topBtns = [_editButton, _hideButton, _escButton, _keybButton];
+                foreach (var btn in topBtns)
+                {
+                    var btnPos = args.Coordinates.Position / btn.UIScale - btn.GlobalPosition;
+                    if (btn.VisibleInTree && btn.HasPoint(btnPos))
+                    {
+                        _claimedTouches[args.FingerId] = btn;
+                        btn.OnTouchDown(args.FingerId);
+                        return true;
+                    }
+                }
+
+                return false;
+            }
+
+            case TouchFingerAction.Motion:
+            {
+                if (_claimedTouches.TryGetValue(args.FingerId, out var target))
+                {
+                    if (target is VirtualThumbstick stick)
+                    {
+                        var stickPos = args.Coordinates.Position / stick.UIScale - stick.GlobalPosition;
+                        stick.OnTouchMove(args.FingerId, stickPos);
+                    }
+                    return true;
+                }
+
+                return false;
+            }
+
+            case TouchFingerAction.Up:
+            case TouchFingerAction.Cancel:
+            {
+                if (_claimedTouches.Remove(args.FingerId, out var target))
+                {
+                    if (target is VirtualThumbstick stick)
+                    {
+                        stick.OnTouchUp(args.FingerId);
+                    }
+                    else if (target is PojavActionButton btn)
+                    {
+                        btn.OnTouchUp(args.FingerId);
+                    }
+                    return true;
+                }
+
+                return false;
+            }
+        }
+
+        return false;
+    }
