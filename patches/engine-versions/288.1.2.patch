+        if (_currentEditingButton == null)
+        {
+            var id = $"custom_{Guid.NewGuid().ToString()[..6]}";
+            var newBtn = CreateButton(name, key, PojavSpecialAction.None, id, isCustom: true);
+            newBtn.IsEditMode = IsEditMode;
+            newBtn.CustomSize = _dialogButtonSize;
+
+            var center = (Size.X > 0 && Size.Y > 0) ? Size / 2f : new Vector2(400, 300);
+            newBtn.CustomPosition = center;
+        }
+        else
+        {
+            _currentEditingButton.Text = name;
+            if (key.HasValue)
+            {
+                _currentEditingButton.ActionKey = key.Value;
+            }
+            _currentEditingButton.CustomSize = _dialogButtonSize;
