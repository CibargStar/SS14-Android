+        internal static AssemblyLoadContext CreateLinkedContext(string name) => new ContentLoadContext(name);
+
+        // A mobile host may carry its own Avalonia and other assemblies. Resolve
+        // trusted engine dependencies in the engine context before default fallback.
+        private sealed class ContentLoadContext(string name) : AssemblyLoadContext(name)
+        {
+            protected override Assembly? Load(AssemblyName name)
+            {
+                var engine = GetLoadContext(typeof(ModLoader).Assembly)!;
+                if (engine == Default) return null;
+                try { return engine.LoadFromAssemblyName(name); }
+                catch (FileNotFoundException) { return null; }
+            }
+        }
