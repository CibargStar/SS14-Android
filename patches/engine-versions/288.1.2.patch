+    private void SaveButtonFromDialog()
+    {
+        var name = string.IsNullOrWhiteSpace(_dialogNameInput.Text) ? "BTN" : _dialogNameInput.Text.Trim();
+        var keyText = _dialogKeyInput.Text.Trim();
