@@ -0,0 +1,170 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+internal enum CameraTouchTarget { World, Interface, Overlay }
+internal enum TouchMouseAction { Move, Down, Up, Cancel }
+
+/// <summary>Arbitrates world taps/drags and two-finger camera gestures before mouse input.</summary>
+internal sealed class CameraTouchState
+{
+    private sealed class Contact(Vector2 position, CameraTouchTarget target, double time)
+    {
+        public Vector2 Position = position;
+        public readonly Vector2 Start = position;
+        public readonly double Started = time;
+        public readonly CameraTouchTarget Target = target;
+        public bool Ignored;
+    }
+
+    private readonly Dictionary<long, Contact> _contacts = new();
+    private long? _mouseOwner;
+    private bool _mouseDown;
+    private (long First, long Second)? _pair;
+    private Vector2? _lastVector;
+    private Vector2 _initialVector;
+    private bool _pinching;
+    private bool _rotating;
+    public event Action<TouchMouseAction, Vector2>? Mouse;
+    public event Action<float, float>? Transform;
+    public bool GestureActive => _pair != null;
+
+    public void Down(long id, Vector2 position, CameraTouchTarget target, double time)
+    {
+        if (!Valid(position)) return;
+        // SDL may lose a terminal event when Android cancels a gesture. A new
+        // DOWN with the reused pointer ID starts a fresh contact, never a hold.
+        if (_contacts.ContainsKey(id)) Up(id, true);
+        var contact = new Contact(position, target, time);
+        _contacts.Add(id, contact);
+        if (target == CameraTouchTarget.Overlay) return;
+        if (target == CameraTouchTarget.World)
+        {
+            foreach (var other in _contacts.Values)
+                if (other.Ignored && other.Target == CameraTouchTarget.World) { contact.Ignored = true; return; }
+        }
+        if (target == CameraTouchTarget.World && _pair == null && !_mouseDown)
+        {
+            foreach (var (otherId, other) in _contacts)
+            {
+                if (otherId == id || other.Ignored || other.Target != CameraTouchTarget.World) continue;
+                _pair = (otherId, id);
+                _mouseOwner = null;
+                _lastVector = null;
+                _pinching = _rotating = false;
+                Rebase();
+                return;
+            }
+        }
+        if (_mouseOwner != null || _pair != null)
+        {
+            contact.Ignored = true;
+            return;
+        }
+        _mouseOwner = id;
+        if (target == CameraTouchTarget.Interface) BeginMouse(contact);
+    }
+
+    public void Move(long id, Vector2 position)
+    {
+        if (!_contacts.TryGetValue(id, out var contact)) return;
+        if (!Valid(position)) { Invalidate(id); return; }
+        contact.Position = position;
+        if (contact.Ignored) return;
+        if (_pair is { } pair && (id == pair.First || id == pair.Second))
+        {
+            var vector = _contacts[pair.Second].Position - _contacts[pair.First].Position;
+            if (vector.LengthSquared() < 24 * 24) { _lastVector = null; return; }
+            if (_lastVector is not { } previous) { _lastVector = _initialVector = vector; _pinching = _rotating = false; return; }
+            var zoomReference = _pinching ? previous : _initialVector;
+            var rotationReference = _rotating ? previous : _initialVector;
+            var ratio = vector.Length() / zoomReference.Length();
+            var angle = MathF.Atan2(rotationReference.X * vector.Y - rotationReference.Y * vector.X, Vector2.Dot(rotationReference, vector));
+            if (!_pinching && MathF.Abs(MathF.Log(ratio)) >= 0.03f) _pinching = true;
+            if (!_rotating && MathF.Abs(angle) >= MathF.PI / 60) _rotating = true;
+            if (_pinching || _rotating)
+            {
+                Transform?.Invoke(_pinching ? ratio : 1, _rotating ? angle : 0);
+                _lastVector = vector;
+            }
+            return;
+        }
+        if (_mouseOwner != id) return;
+        if (!_mouseDown && Vector2.DistanceSquared(position, contact.Start) >= 12 * 12) BeginMouse(contact);
+        if (_mouseDown) Mouse?.Invoke(TouchMouseAction.Move, position);
+    }
+
+    public void Update(double time)
+    {
+        if (_pair == null && !_mouseDown && _mouseOwner is { } id && _contacts.TryGetValue(id, out var contact)
+            && !contact.Ignored && time - contact.Started >= 0.35)
+            BeginMouse(contact);
+    }
+
+    public void Up(long id, bool cancelled)
+    {
+        if (!_contacts.TryGetValue(id, out var contact)) return;
+        if (_pair is { } pair && (id == pair.First || id == pair.Second)) EndPair();
+        if (_mouseOwner == id)
+        {
+            if (!contact.Ignored && !cancelled && !_mouseDown) BeginMouse(contact);
+            if (_mouseDown) Mouse?.Invoke(cancelled ? TouchMouseAction.Cancel : TouchMouseAction.Up, contact.Position);
+            _mouseOwner = null;
+            _mouseDown = false;
+        }
+        _contacts.Remove(id);
+    }
+
+    public void Invalidate(long id)
+    {
+        if (!_contacts.TryGetValue(id, out var contact)) return;
+        contact.Ignored = true;
+        if (_pair is { } pair && (id == pair.First || id == pair.Second)) EndPair();
+        if (_mouseOwner == id)
+        {
+            if (_mouseDown) Mouse?.Invoke(TouchMouseAction.Cancel, contact.Position);
+            _mouseOwner = null;
+            _mouseDown = false;
+        }
+    }
+
+    public void Cancel()
+    {
+        if (_mouseDown && _mouseOwner is { } id && _contacts.TryGetValue(id, out var contact))
+            Mouse?.Invoke(TouchMouseAction.Cancel, contact.Position);
+        _contacts.Clear();
+        _mouseOwner = null;
+        _mouseDown = false;
+        _pair = null;
+        _lastVector = null;
+        _pinching = _rotating = false;
+    }
+
+    private void BeginMouse(Contact contact)
+    {
+        _mouseDown = true;
+        Mouse?.Invoke(TouchMouseAction.Move, contact.Start);
+        Mouse?.Invoke(TouchMouseAction.Down, contact.Start);
+    }
+
+    private void Rebase()
+    {
+        if (_pair is not { } pair) return;
+        var vector = _contacts[pair.Second].Position - _contacts[pair.First].Position;
+        if (vector.LengthSquared() >= 24 * 24) _lastVector = _initialVector = vector;
+    }
+
+    private void EndPair()
+    {
+        if (_pair is not { } pair) return;
+        _contacts[pair.First].Ignored = true;
+        _contacts[pair.Second].Ignored = true;
+        _pair = null;
+        _lastVector = null;
+        _pinching = _rotating = false;
+    }
+
+    private static bool Valid(Vector2 value) => float.IsFinite(value.X) && float.IsFinite(value.Y);
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileCameraTransform.cs b/Robust.Client/UserInterface/Mobile/MobileCameraTransform.cs
new file mode 100644
index 0000000..1d00f75
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileCameraTransform.cs
@@ -0,0 +1,56 @@
+using System;
+using System.Numerics;
+using Robust.Shared.Graphics;
+using Robust.Shared.Map;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+/// <summary>Local optical magnification and rotation; never changes server eye/FOV data.</summary>
+internal static class MobileCameraTransform
+{
+    private static IEye? _source;
+    private static CameraEye? _view;
+    public static float Magnification { get; private set; } = 1;
+    public static float Rotation { get; private set; }
+
+    public static void Bind(IEye eye)
+    {
+        if (ReferenceEquals(_source, eye)) return;
+        _source = eye;
+        _view = new CameraEye(eye);
+        Magnification = 1;
+        Rotation = 0;
+    }
+
+    public static void Apply(float distanceRatio, float angle)
+    {
+        if (!float.IsFinite(distanceRatio) || distanceRatio <= 0 || !float.IsFinite(angle)) return;
+        // Magnify the server's normal view and allow returning to its baseline.
+        Magnification = Math.Clamp(Magnification * distanceRatio, 1, 4);
+        Rotation = MathF.IEEERemainder(Rotation - angle, MathF.Tau);
+    }
+
+    public static IEye? For(IEye? eye) => eye != null && ReferenceEquals(eye, _source)
+        && (Magnification != 1 || Rotation != 0) ? _view : eye;
+
+    private sealed class CameraEye(IEye source) : IEye
+    {
+        public bool DrawFov { get => source.DrawFov; set => source.DrawFov = value; }
+        public bool DrawLight { get => source.DrawLight; set => source.DrawLight = value; }
+        public MapCoordinates Position => source.Position;
+        public Vector2 Offset { get => source.Offset; set => source.Offset = value; }
+        public Angle Rotation { get => source.Rotation + new Angle(MobileCameraTransform.Rotation); set => source.Rotation = value - new Angle(MobileCameraTransform.Rotation); }
+        public Vector2 Scale { get => source.Scale * Magnification; set => source.Scale = value / Magnification; }
+        public Vector2 Zoom { get => source.Zoom / Magnification; set => source.Zoom = value * Magnification; }
+        public void GetViewMatrix(out Matrix3x2 matrix, Vector2 renderScale) =>
+            matrix = Matrix3Helpers.CreateInverseTransform(Position.Position.X + Offset.X, Position.Position.Y + Offset.Y,
+                (float)-Rotation.Theta, 1 / (Scale.X * renderScale.X), 1 / (Scale.Y * renderScale.Y));
+        public void GetViewMatrixNoOffset(out Matrix3x2 matrix, Vector2 renderScale) =>
+            matrix = Matrix3Helpers.CreateInverseTransform(Position.Position.X, Position.Position.Y,
+                (float)-Rotation.Theta, 1 / (Scale.X * renderScale.X), 1 / (Scale.Y * renderScale.Y));
+        public void GetViewMatrixInv(out Matrix3x2 matrix, Vector2 renderScale) =>
+            matrix = Matrix3Helpers.CreateTransform(Position.Position.X + Offset.X, Position.Position.Y + Offset.Y,
+                (float)-Rotation.Theta, 1 / (Scale.X * renderScale.X), 1 / (Scale.Y * renderScale.Y));
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileControlsOverlay.cs b/Robust.Client/UserInterface/Mobile/MobileControlsOverlay.cs
new file mode 100644
index 0000000..9eed978
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileControlsOverlay.cs
@@ -0,0 +1,125 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared;
+using Robust.Shared.Configuration;
+using Robust.Shared.IoC;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+using Robust.Shared.Timing;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// Only movement belongs to the touch overlay. Actions remain in the real HUD.
+public sealed class MobileControlsOverlay : Control
+{
+    [Dependency] private IConfigurationManager _cfg = default!;
+    [Dependency] private IUserInterfaceManagerInternal _uiMgr = default!;
+    private readonly VirtualThumbstick _thumbstick;
+    private readonly HashSet<long> _claimedTouches = new();
+    private MobileDisplaySettingsWindow? _settingsWindow;
+    private MobileDebugWindow? _debugWindow;
+    private readonly Button _settingsButton;
+
+    public bool BlocksWorldGestures => false;
+
+    public MobileControlsOverlay()
+    {
+        IoCManager.InjectDependencies(this);
+        MouseFilter = MouseFilterMode.Ignore;
+        _thumbstick = new VirtualThumbstick();
+        AddChild(_thumbstick);
+        _settingsButton = new Button { Name = "MobileDisplayButton", Text = "UI", MinSize = new Vector2(44, 36) };
+        _settingsButton.OnPressed += _ => OpenDisplaySettings();
+        AddChild(_settingsButton);
+        _cfg.OnValueChanged(CVars.MobileControlsVisible, ControlsVisibilityChanged, true);
+    }
+
+    private void ControlsVisibilityChanged(bool visible)
+    {
+        _thumbstick.Visible = visible;
+        if (!visible) { _thumbstick.ReleaseStick(); _claimedTouches.Clear(); }
+        if (AppDomain.CurrentDomain.GetData("SS14_ANDROID_DISPLAY_SAVE") is Action<float, bool> save)
+            save(_cfg.GetCVar(CVars.DisplayUIScale), visible);
+    }
+
+    public bool HandleTouch(TouchFingerEventArgs args)
+    {
+        if (args.Action is TouchFingerAction.Up or TouchFingerAction.Cancel)
+        {
+            var claimed = _claimedTouches.Remove(args.FingerId);
+            _thumbstick.OnTouchUp(args.FingerId);
+            return claimed;
+        }
+        if (args.Action == TouchFingerAction.Down)
+        {
+            _claimedTouches.Remove(args.FingerId);
+            _thumbstick.OnTouchUp(args.FingerId);
+            var position = args.Coordinates.Position / _thumbstick.UIScale - _thumbstick.GlobalPosition;
+            // A window covering the stick must receive its own input.
+            var hit = _uiMgr.MouseGetControl(args.Coordinates);
+            if (!_thumbstick.VisibleInTree || !_thumbstick.HasPoint(position) || hit != _thumbstick) return false;
+            _claimedTouches.Add(args.FingerId);
+            _thumbstick.OnTouchDown(args.FingerId, position);
+            return true;
+        }
+        if (args.Action == TouchFingerAction.Motion && _claimedTouches.Contains(args.FingerId))
+        {
+            _thumbstick.OnTouchMove(args.FingerId, args.Coordinates.Position / _thumbstick.UIScale - _thumbstick.GlobalPosition);
+            return true;
+        }
+        return false;
+    }
+
+    public void SynchronizeTouchContacts(long[] activeFingers)
+    {
+        _thumbstick.SynchronizeTouchContacts(activeFingers);
+        _claimedTouches.RemoveWhere(id => Array.IndexOf(activeFingers, id) < 0);
+    }
+
+    protected override void FrameUpdate(FrameEventArgs args)
+    {
+        base.FrameUpdate(args);
+        if (AppDomain.CurrentDomain.GetData("SS14_ANDROID_ACTIVE_TOUCHES") is Func<long[]> snapshot)
+            SynchronizeTouchContacts(snapshot());
+    }
+
+    public void OpenDisplaySettings()
+    {
+        if (_settingsWindow is { IsOpen: true }) return;
+        var window = new MobileDisplaySettingsWindow(_uiMgr.RootControl.Size, ToggleDebug);
+        _settingsWindow = window;
+        window.OnClose += () => { window.Dispose(); _settingsWindow = null; };
+        window.OpenCentered();
+    }
+
+    public void ToggleDebug()
+    {
+        if (_debugWindow is { IsOpen: true }) { _debugWindow.Close(); return; }
+        var window = new MobileDebugWindow(_uiMgr.RootControl.Size);
+        _debugWindow = window;
+        window.OnClose += () => _debugWindow = null;
+        window.OpenCentered();
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        var scale = MobileDisplaySizing.ControlsScale(UIScale, finalSize.Y * UIScale, _cfg.GetCVar(CVars.MobileControlsScale));
+        var stickScale = Math.Clamp(_cfg.GetCVar(CVars.MobileThumbstickScale), 0.5f, 2);
+        _thumbstick.Radius = 75 * scale * stickScale;
+        _thumbstick.KnobRadius = 32 * scale * stickScale;
+        _thumbstick.Deadzone = 10 * scale * stickScale;
+        var size = new Vector2(_thumbstick.Radius * 2 + 20);
+        var position = new Vector2(35 * scale, finalSize.Y * 0.66f - _thumbstick.Radius);
+        position = Vector2.Clamp(position, Vector2.Zero, Vector2.Max(Vector2.Zero, finalSize - size));
+        _settingsButton.Measure(new Vector2(44, 36));
+        _settingsButton.Arrange(UIBox2.FromDimensions(new Vector2(MathF.Max(0, (finalSize.X - 44) / 2), 8), new Vector2(44, 36)));
+        _thumbstick.DefaultPosition = position;
+        _thumbstick.Measure(size);
+        _thumbstick.Arrange(UIBox2.FromDimensions(position, size));
+        return finalSize;
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileDisplaySettingsWindow.cs b/Robust.Client/UserInterface/Mobile/MobileDisplaySettingsWindow.cs
new file mode 100644
index 0000000..e342e41
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileDisplaySettingsWindow.cs
@@ -0,0 +1,63 @@
+using System;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Client.UserInterface.CustomControls;
+using Robust.Shared;
+using Robust.Shared.Configuration;
+using Robust.Shared.IoC;
+using Robust.Shared.Localization;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public sealed partial class MobileDisplaySettingsWindow : DefaultWindow
+{
+    [Dependency] private IConfigurationManager _cfg = default!;
+
+    public MobileDisplaySettingsWindow(Vector2 available, Action? toggleDebug = null)
+    {
+        IoCManager.InjectDependencies(this);
+        Title = Loc.GetString("mobile-display-title");
+        MinSize = new Vector2(MathF.Min(420, MathF.Max(160, available.X - 24)),
+            MathF.Min(360, MathF.Max(120, available.Y - 24)));
+        MaxSize = Vector2.Max(new Vector2(160, 120), available - new Vector2(24));
+        var scroll = new ScrollContainer { HorizontalExpand = true, VerticalExpand = true };
+        Contents.AddChild(scroll);
+        var column = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical,
+            SeparationOverride = 12, Margin = new Robust.Shared.Maths.Thickness(12) };
+        scroll.AddChild(column);
+        if (toggleDebug != null)
+        {
+            var debug = new Button { Text = "Debug" };
+            debug.OnPressed += _ => { Close(); toggleDebug(); };
+            column.AddChild(debug);
+        }
+        var initial = _cfg.GetCVar(CVars.DisplayUIScale);
+        var automatic = new CheckBox { Text = Loc.GetString("mobile-display-auto"), Pressed = initial == 0 };
+        var value = new Label();
+        var slider = new Slider { MinValue = 25, MaxValue = 200, Value = initial > 0 ? initial * 100 : 100,
+            Rounded = true, MinHeight = 36, HorizontalExpand = true, Disabled = automatic.Pressed };
+        void UpdateLabel() => value.Text = automatic.Pressed ? Loc.GetString("mobile-display-auto") :
+            Loc.GetString("mobile-display-scale", ("percent", (int)slider.Value));
+        slider.OnValueChanged += _ => UpdateLabel();
+        automatic.OnToggled += _ => { slider.Disabled = automatic.Pressed; UpdateLabel(); };
+        column.AddChild(automatic);
+        column.AddChild(value);
+        column.AddChild(slider);
+        var show = new CheckBox { Text = Loc.GetString("mobile-display-controls"),
+            Pressed = _cfg.GetCVar(CVars.MobileControlsVisible) };
+        column.AddChild(show);
+        var reset = new Button { Text = Loc.GetString("mobile-display-reset") };
+        reset.OnPressed += _ => { automatic.Pressed = true; slider.Value = 100; show.Pressed = true; UpdateLabel(); };
+        column.AddChild(reset);
+        var apply = new Button { Text = Loc.GetString("mobile-display-apply") };
+        apply.OnPressed += _ =>
+        {
+            _cfg.SetCVar(CVars.DisplayUIScale, automatic.Pressed ? 0 : slider.Value / 100);
+            _cfg.SetCVar(CVars.MobileControlsVisible, show.Pressed);
+            _cfg.SaveToFile();
+            Close();
+        };
+        column.AddChild(apply);
+        UpdateLabel();
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileDisplaySizing.cs b/Robust.Client/UserInterface/Mobile/MobileDisplaySizing.cs
new file mode 100644
index 0000000..b4d5757
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileDisplaySizing.cs
@@ -0,0 +1,20 @@
+using System;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public static class MobileDisplaySizing
+{
+    public static float UiScale(int width, int height, float selectedScale)
+    {
+        if (float.IsFinite(selectedScale) && selectedScale > 0)
+            return Math.Clamp(selectedScale, 0.25f, 3f);
+        if (width <= 0 || height <= 0) return 1;
+        return Math.Clamp(Math.Min(width / 1280f, height / 720f), 0.25f, 3f);
+    }
+
+    public static float ControlsScale(float uiScale, float pixelHeight, float selectedScale)
+    {
+        var responsive = Math.Clamp(pixelHeight / 1080f, 0.4f, 2f);
+        return Math.Clamp(selectedScale, 0.6f, 3f) * responsive / Math.Clamp(uiScale, 0.25f, 3f);
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileTouchController.cs b/Robust.Client/UserInterface/Mobile/MobileTouchController.cs
new file mode 100644
index 0000000..801c670
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileTouchController.cs
@@ -0,0 +1,93 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Shared.Graphics;
+using Robust.Shared.Map;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+internal sealed class MobileTouchController
+{
+    private readonly CameraTouchState _state = new();
+    private readonly IEyeManager _eyes;
+    private readonly Func<ScreenCoordinates, bool> _freeWorld;
+    private readonly Action _cancelMouseFocus;
+    private readonly Dictionary<long, ScreenCoordinates> _worldTouches = new();
+    private Action<TouchMouseAction, ScreenCoordinates>? _emit;
+    private ScreenCoordinates _screen;
+    private float _scale = 1;
+    private IEye? _lastEye;
+
+    public MobileTouchController(IClyde clyde, IEyeManager eyes, Func<ScreenCoordinates, bool> freeWorld, Action cancelMouseFocus)
+    {
+        _eyes = eyes;
+        _freeWorld = freeWorld;
+        _cancelMouseFocus = cancelMouseFocus;
+        _state.Transform += MobileCameraTransform.Apply;
+        _state.Mouse += (action, position) =>
+        {
+            if (action == TouchMouseAction.Cancel) _cancelMouseFocus();
+            _emit?.Invoke(action, new ScreenCoordinates(position * _scale, _screen.Window));
+        };
+        clyde.OnWindowFocused += args => { if (!args.Focused) Cancel(); };
+        clyde.OnWindowResized += _ => Cancel();
+    }
+
+    private static double Now => Stopwatch.GetTimestamp() / (double)Stopwatch.Frequency;
+
+    public void Handle(TouchFingerEventArgs args, bool overlayHandled, float scale)
+    {
+        Update();
+        if (args.EmitMouse != null) _emit = args.EmitMouse;
+        if (args.Action == TouchFingerAction.Down)
+        {
+            // UI pointer emulation is tied to one window and its current scale.
+            if (_screen.Window != args.Coordinates.Window || _scale != scale) Cancel();
+            _screen = args.Coordinates;
+            _scale = scale > 0 && float.IsFinite(scale) ? scale : 1;
+            var world = !overlayHandled && _freeWorld(args.Coordinates);
+            if (world) _worldTouches[args.FingerId] = args.Coordinates;
+            _state.Down(args.FingerId, args.Coordinates.Position / _scale,
+                overlayHandled ? CameraTouchTarget.Overlay : world ? CameraTouchTarget.World : CameraTouchTarget.Interface, Now);
+        }
+        else if (args.Action == TouchFingerAction.Motion)
+        {
+            if (_worldTouches.ContainsKey(args.FingerId))
+            {
+                _worldTouches[args.FingerId] = args.Coordinates;
+                if (!_freeWorld(args.Coordinates)) _state.Invalidate(args.FingerId);
+            }
+            _state.Move(args.FingerId, args.Coordinates.Position / _scale);
+        }
+        else
+        {
+            if (_worldTouches.ContainsKey(args.FingerId) && !_freeWorld(args.Coordinates)) _state.Invalidate(args.FingerId);
+            _state.Up(args.FingerId, args.Action == TouchFingerAction.Cancel);
+            _worldTouches.Remove(args.FingerId);
+        }
+    }
+
+    public void InvalidateTouch(long id) => _state.Invalidate(id);
+
+    public void Update()
+    {
+        var eye = _eyes.CurrentEye;
+        if (!ReferenceEquals(_lastEye, eye))
+        {
+            Cancel();
+            _lastEye = eye;
+            MobileCameraTransform.Bind(eye);
+        }
+        foreach (var (id, position) in _worldTouches)
+            if (!_freeWorld(position)) _state.Invalidate(id);
+        _state.Update(Now);
+    }
+
+    private void Cancel()
+    {
+        _state.Cancel();
+        _worldTouches.Clear();
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/ThumbstickState.cs b/Robust.Client/UserInterface/Mobile/ThumbstickState.cs
new file mode 100644
index 0000000..cdde4db
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/ThumbstickState.cs
@@ -0,0 +1,117 @@
+using System;
+using System.Numerics;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+[Flags]
+internal enum StickDirection : byte
+{
+    None = 0,
+    Up = 1,
+    Right = 2,
+    Down = 4,
+    Left = 8,
+}
+
+/// <summary>Pointer ownership and stable eight-way movement, independent of frame rate.</summary>
+internal sealed class ThumbstickState
+{
+    public static StickDirection CameraRelative(StickDirection direction, float rotation)
+    {
+        if (direction == StickDirection.None || !float.IsFinite(rotation)) return direction;
+        var x = ((direction & StickDirection.Right) != 0 ? 1 : 0) - ((direction & StickDirection.Left) != 0 ? 1 : 0);
+        var y = ((direction & StickDirection.Down) != 0 ? 1 : 0) - ((direction & StickDirection.Up) != 0 ? 1 : 0);
+        var angle = MathF.Atan2(y, x) + rotation;
+        return ((int)MathF.Floor((angle + MathF.PI / 8) / (MathF.PI / 4)) & 7) switch
+        {
+            0 => StickDirection.Right, 1 => StickDirection.Down | StickDirection.Right,
+            2 => StickDirection.Down, 3 => StickDirection.Down | StickDirection.Left,
+            4 => StickDirection.Left, 5 => StickDirection.Up | StickDirection.Left,
+            6 => StickDirection.Up, _ => StickDirection.Up | StickDirection.Right,
+        };
+    }
+    private const float SectorAngle = MathF.PI / 4;
+    private const float AngularHysteresis = MathF.PI / 36; // Five degrees.
+    private int? _sector;
+
+    public bool IsPressed { get; private set; }
+    public long? FingerId { get; private set; }
+    public Vector2 Offset { get; private set; }
+    public StickDirection Direction { get; private set; }
+
+    public bool Press(long? fingerId, Vector2 offset, float deadzone, float travel)
+    {
+        // A second finger or synthetic mouse press cannot steal a held stick.
+        if (IsPressed) return false;
+        IsPressed = true;
+        FingerId = fingerId;
+        Move(fingerId, offset, deadzone, travel);
+        return true;
+    }
+
+    public bool Move(long? fingerId, Vector2 offset, float deadzone, float travel)
+    {
+        if (!IsPressed || FingerId != fingerId) return false;
+        if (!float.IsFinite(offset.X) || !float.IsFinite(offset.Y))
+        {
+            Neutral();
+            return true;
+        }
+        var distance = offset.Length();
+        if (!float.IsFinite(distance))
+        {
+            Neutral();
+            return true;
+        }
+        Offset = distance > 0 ? offset * (MathF.Min(distance, MathF.Max(0, travel)) / distance) : Vector2.Zero;
+        // Separate start/stop radii avoid rapid walk/stop toggles near the centre.
+        var threshold = MathF.Max(0.001f, deadzone) * (Direction == StickDirection.None ? 1 : 0.75f);
+        if (distance < threshold)
+        {
+            Direction = StickDirection.None;
+            _sector = null;
+            return true;
+        }
+        var angle = MathF.Atan2(offset.Y, offset.X);
+        var next = (int)MathF.Floor((angle + SectorAngle / 2) / SectorAngle) & 7;
+        if (_sector is { } previous)
+        {
+            var difference = MathF.Abs(MathF.IEEERemainder(angle - previous * SectorAngle, MathF.Tau));
+            if (difference <= SectorAngle / 2 + AngularHysteresis) next = previous;
+        }
+        _sector = next;
+        Direction = next switch
+        {
+            0 => StickDirection.Right,
+            1 => StickDirection.Down | StickDirection.Right,
+            2 => StickDirection.Down,
+            3 => StickDirection.Down | StickDirection.Left,
+            4 => StickDirection.Left,
+            5 => StickDirection.Up | StickDirection.Left,
+            6 => StickDirection.Up,
+            _ => StickDirection.Up | StickDirection.Right,
+        };
+        return true;
+    }
+
+    public bool Release(long? fingerId)
+    {
+        if (!IsPressed || FingerId != fingerId) return false;
+        Cancel();
+        return true;
+    }
+
+    public void Cancel()
+    {
+        IsPressed = false;
+        FingerId = null;
+        Neutral();
+    }
+
+    private void Neutral()
+    {
+        Direction = StickDirection.None;
+        Offset = Vector2.Zero;
+        _sector = null;
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs b/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs
new file mode 100644
index 0000000..9c394ba
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/VirtualThumbstick.cs
@@ -0,0 +1,324 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface;
+using Robust.Shared.Input;
+using Robust.Shared.IoC;
+using Robust.Shared.Maths;
+using Robust.Shared.Timing;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+public sealed partial class VirtualThumbstick : Control
+{
+    [Dependency] private IInputManager _inputManager = default!;
+    [Dependency] private IClyde _clyde = default!;
+
+    public float Radius { get; set; } = 75f;
+    public float KnobRadius { get; set; } = 32f;
+    public float Deadzone { get; set; } = 10f;
+
+    public Vector2 DefaultPosition { get; set; }
+    public Vector2? CustomPosition { get; set; }
+    public bool IsEditMode { get; set; }
+    public event Action? OnPositionChanged;
+    public event Action? OnStickSteering;
+
+    public bool IsPressed => _isPressed;
+
+    private readonly ThumbstickState _stick = new();
+    private float _lastCameraRotation;
+    private bool _isPressed => _stick.IsPressed;
+    private Vector2 _knobOffset => _stick.Offset;
+    private Vector2? _dragTouchOffset;
+    private readonly HashSet<Keyboard.Key> _activeKeys = new();
+    private static readonly (Keyboard.Key Key, StickDirection Direction)[] MovementKeys =
+    [
+        (Keyboard.Key.W, StickDirection.Up), (Keyboard.Key.S, StickDirection.Down),
+        (Keyboard.Key.A, StickDirection.Left), (Keyboard.Key.D, StickDirection.Right),
+    ];
+
+    public VirtualThumbstick()
+    {
+        IoCManager.InjectDependencies(this);
+        MouseFilter = MouseFilterMode.Stop;
+        SetSize = new Vector2(Radius * 2f + 20f, Radius * 2f + 20f);
+    }
+
+    private long? _activeFingerId => _stick.FingerId;
+
+    protected override void EnteredTree()
+    {
+        base.EnteredTree();
+        _clyde.OnWindowFocused += WindowFocusChanged;
+    }
+
+    protected override void ExitedTree()
+    {
+        _clyde.OnWindowFocused -= WindowFocusChanged;
+        ReleaseStick();
+        base.ExitedTree();
+    }
+
+    private void WindowFocusChanged(WindowFocusedEventArgs args)
+    {
+        if (!args.Focused) ReleaseStick();
+    }
+
+    public void OnTouchDown(long fingerId, Vector2 localPos)
+    {
+        if (IsEditMode)
+            return;
+
+        var offset = localPos - (Size / 2f);
+        if (_stick.Press(fingerId, offset, Deadzone, MathF.Max(0, Radius - KnobRadius)))
+            ApplyMovement();
+    }
+
+    public void OnTouchMove(long fingerId, Vector2 localPos)
+    {
+        if (IsEditMode || !_isPressed || _activeFingerId != fingerId)
+            return;
+
+        var offset = localPos - (Size / 2f);
+        UpdateStickOffset(offset);
+    }
+
+    public void OnTouchUp(long fingerId)
+    {
+        if (_activeFingerId == fingerId)
+        {
+            ReleaseStick();
+        }
+    }
+
+    public void ReleaseStick()
+    {
+        _stick.Cancel();
+        ReleaseAllKeys();
+        if (UserInterfaceManager.ControlFocused == this)
+            UserInterfaceManager.ControlFocused = null;
+    }
+
+    public void SynchronizeTouchContacts(long[] activeFingers)
+    {
+        if (_activeFingerId is { } finger && Array.IndexOf(activeFingers, finger) < 0)
+            ReleaseStick();
+    }
+
+    protected internal override bool HasPoint(Vector2 point)
+    {
+        var center = Size / 2f;
+        var distSq = (point - center).LengthSquared();
+        var touchRadius = Radius + 25f;
+        return distSq <= touchRadius * touchRadius;
+    }
+
+    protected internal override void ControlFocusExited()
+    {
+        base.ControlFocusExited();
+        if (IsEditMode)
+        {
+            _dragTouchOffset = null;
+        }
+        else if (_isPressed && _activeFingerId == null)
+        {
+            ReleaseStick();
+        }
+    }
+
+    protected internal override void KeyBindDown(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindDown(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            UserInterfaceManager.ControlFocused = this;
+            _dragTouchOffset = args.RelativePosition;
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        var offset = args.RelativePosition - (Size / 2f);
+        if (_stick.Press(null, offset, Deadzone, MathF.Max(0, Radius - KnobRadius)))
+        {
+            UserInterfaceManager.ControlFocused = this;
+            ApplyMovement();
+        }
+        args.Handle();
+    }
+
+    protected internal override void MouseMove(GUIMouseMoveEventArgs args)
+    {
+        base.MouseMove(args);
+
+        if (IsEditMode && _dragTouchOffset != null)
+        {
+            var parentGlobal = Parent?.GlobalPosition ?? Vector2.Zero;
+            var currentGlobal = GlobalPosition + args.RelativePosition;
+            var newGlobal = currentGlobal - _dragTouchOffset.Value;
+            var newLocal = newGlobal - parentGlobal;
+            CustomPosition = newLocal;
+            Arrange(new UIBox2(newLocal, newLocal + Size));
+            OnPositionChanged?.Invoke();
+            return;
+        }
+
+        if (_activeFingerId != null || !_isPressed || IsEditMode)
+            return;
+
+        var offset = args.RelativePosition - (Size / 2f);
+        UpdateStickOffset(offset);
+    }
+
+    protected internal override void KeyBindUp(GUIBoundKeyEventArgs args)
+    {
+        base.KeyBindUp(args);
+
+        if (args.Function != EngineKeyFunctions.UIClick)
+            return;
+
+        if (IsEditMode)
+        {
+            if (UserInterfaceManager.ControlFocused == this)
+                UserInterfaceManager.ControlFocused = null;
+
+            if (_dragTouchOffset != null)
+            {
+                _dragTouchOffset = null;
+                OnPositionChanged?.Invoke();
+            }
+            args.Handle();
+            return;
+        }
+
+        if (_activeFingerId != null)
+        {
+            args.Handle();
+            return;
+        }
+
+        if (!_isPressed)
+            return;
+
+        ReleaseStick();
+        args.Handle();
+    }
+
+    private void UpdateStickOffset(Vector2 rawOffset)
+    {
+        if (_stick.Move(_activeFingerId, rawOffset, Deadzone, MathF.Max(0, Radius - KnobRadius)))
+            ApplyMovement();
+    }
+
+    private void ApplyMovement()
+    {
+        _lastCameraRotation = MobileCameraTransform.Rotation;
+        var movement = ThumbstickState.CameraRelative(_stick.Direction, _lastCameraRotation);
+        if (_stick.Direction != StickDirection.None) OnStickSteering?.Invoke();
+        // Release old directions before pressing new ones, including a direct
+        // reversal, so the original input stack never sees opposing keys held.
+        foreach (var (key, direction) in MovementKeys)
+            if ((movement & direction) == 0) SetMovementKey(key, false);
+        foreach (var (key, direction) in MovementKeys)
+            if ((movement & direction) != 0) SetMovementKey(key, true);
+    }
+
+    protected override void FrameUpdate(FrameEventArgs args)
+    {
+        base.FrameUpdate(args);
+        if (_isPressed && _lastCameraRotation != MobileCameraTransform.Rotation) ApplyMovement();
+    }
+
+    private void SetMovementKey(Keyboard.Key key, bool down)
+    {
+        if (down ? !_activeKeys.Add(key) : !_activeKeys.Remove(key)) return;
+        var args = new KeyEventArgs(key, false, false, false, false, false, 0);
+        if (down) _inputManager.KeyDown(args);
+        else _inputManager.KeyUp(args);
+    }
+
+    private void ReleaseAllKeys()
+    {
+        foreach (var key in _activeKeys)
+        {
+            _inputManager.KeyUp(new KeyEventArgs(key, false, false, false, false, false, 0));
+        }
+        _activeKeys.Clear();
+    }
+
+    protected internal override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+
+        var scale = UIScale;
+        var center = (Vector2)PixelSize / 2f;
+        var radius = Radius * scale;
+
+        handle.DrawCircle(center, radius, new Color(15, 15, 15, 150), true);
+        var baseBorder = IsEditMode ? new Color(255, 215, 0, 240) : new Color(240, 240, 240, 200);
+        handle.DrawCircle(center, radius, baseBorder, false);
+
+        handle.DrawCircle(center, radius * 0.55f, new Color(255, 255, 255, 25), false);
+
+        var wActive = (_stick.Direction & StickDirection.Up) != 0;
+        var sActive = (_stick.Direction & StickDirection.Down) != 0;
+        var aActive = (_stick.Direction & StickDirection.Left) != 0;
+        var dActive = (_stick.Direction & StickDirection.Right) != 0;
+
+        var activeColor = new Color(255, 225, 60, 255);
+        var inactiveColor = new Color(255, 255, 255, 140);
+
+        var dotRadius = (Radius - 10f) * scale;
+        handle.DrawCircle(center + new Vector2(0, -dotRadius), (wActive ? 6.5f : 4f) * scale, wActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(0, dotRadius), (sActive ? 6.5f : 4f) * scale, sActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-dotRadius, 0), (aActive ? 6.5f : 4f) * scale, aActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(dotRadius, 0), (dActive ? 6.5f : 4f) * scale, dActive ? activeColor : inactiveColor, true);
+
+        var diagOffset = dotRadius * 0.7071f;
+        var wdActive = wActive && dActive;
+        var waActive = wActive && aActive;
+        var sdActive = sActive && dActive;
+        var saActive = sActive && aActive;
+
+        handle.DrawCircle(center + new Vector2(diagOffset, -diagOffset), (wdActive ? 6.5f : 3f) * scale, wdActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-diagOffset, -diagOffset), (waActive ? 6.5f : 3f) * scale, waActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(diagOffset, diagOffset), (sdActive ? 6.5f : 3f) * scale, sdActive ? activeColor : inactiveColor, true);
+        handle.DrawCircle(center + new Vector2(-diagOffset, diagOffset), (saActive ? 6.5f : 3f) * scale, saActive ? activeColor : inactiveColor, true);
+
+        handle.DrawCircle(center, 5f * scale, new Color(255, 255, 255, 90), true);
+
+        if (_isPressed && _knobOffset.LengthSquared() > 9f)
+        {
+            handle.DrawLine(center, center + _knobOffset * scale, new Color(255, 255, 255, 140));
+        }
+
+        var knobCenter = center + _knobOffset * scale;
+        var knobBg = _isPressed
+            ? new Color(255, 255, 255, 235)
+            : new Color(210, 210, 210, 185);
+
+        var knobBorder = Color.White;
+
+        handle.DrawCircle(knobCenter, KnobRadius * scale, knobBg, true);
+        handle.DrawCircle(knobCenter, KnobRadius * scale, knobBorder, false);
+        handle.DrawCircle(knobCenter, 6f * scale, new Color(30, 30, 30, 220), true);
+
+        if (IsEditMode)
+        {
+            var box = UIBox2.FromDimensions(Vector2.Zero, PixelSize);
+            handle.DrawRect(box, new Color(255, 215, 0, 150), false);
+        }
+    }
+}
