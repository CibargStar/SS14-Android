+++ b/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs
@@ -0,0 +1,60 @@
+using System;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// ContainerButton retains the active content stylesheet and normal UI input.
+internal sealed class MobileHudIconButton : ContainerButton
+{
+    public enum Symbol { Chat, Send, Expand, Compact, Fold, Unfold }
+    public Symbol Icon { get; set; }
+
+    public MobileHudIconButton(Symbol icon, string name, string tooltip)
+    {
+        Icon = icon;
+        Name = name;
+        ToolTip = tooltip;
+        MinSize = new Vector2(40);
+    }
+
+    protected internal override void Draw(DrawingHandleScreen handle)
+    {
+        base.Draw(handle);
+        var size = PixelSize;
+        var centre = (Vector2)size / 2;
+        var unit = MathF.Min(size.X, size.Y) * 0.23f;
+        var color = Disabled ? new Color(0.4f, 0.4f, 0.5f) : Color.FromHex("#b5c4d2");
+        void Line(float x1, float y1, float x2, float y2) => handle.DrawLine(
+            centre + new Vector2(x1, y1) * unit, centre + new Vector2(x2, y2) * unit, color);
+        switch (Icon)
+        {
+            case Symbol.Chat:
+                Line(-1, -0.8f, 1, -0.8f); Line(1, -0.8f, 1, 0.6f);
+                Line(1, 0.6f, -0.4f, 0.6f); Line(-0.4f, 0.6f, -1, 1);
+                Line(-1, 1, -1, -0.8f); Line(-0.6f, -0.2f, 0.6f, -0.2f);
+                break;
+            case Symbol.Send:
+                Line(-1, -0.8f, 1, 0); Line(1, 0, -1, 0.8f);
+                Line(-1, 0.8f, -0.5f, 0); Line(-0.5f, 0, -1, -0.8f); Line(-0.5f, 0, 1, 0);
+                break;
+            case Symbol.Expand:
+                Line(-1, -0.3f, -1, -1); Line(-1, -1, -0.3f, -1);
+                Line(1, 0.3f, 1, 1); Line(1, 1, 0.3f, 1);
+                Line(-1, -1, -0.2f, -0.2f); Line(1, 1, 0.2f, 0.2f);
+                break;
+            case Symbol.Compact:
+                Line(-1, -0.3f, -0.3f, -0.3f); Line(-0.3f, -0.3f, -0.3f, -1);
+                Line(1, 0.3f, 0.3f, 0.3f); Line(0.3f, 0.3f, 0.3f, 1);
+                break;
+            case Symbol.Fold:
+                Line(0.5f, -0.8f, -0.5f, 0); Line(-0.5f, 0, 0.5f, 0.8f);
+                break;
+            case Symbol.Unfold:
+                Line(-0.5f, -0.8f, 0.5f, 0); Line(0.5f, 0, -0.5f, 0.8f);
+                break;
+        }
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileMenuStrip.cs b/Robust.Client/UserInterface/Mobile/MobileMenuStrip.cs
new file mode 100644
index 0000000..d95f951
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileMenuStrip.cs
@@ -0,0 +1,45 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+internal sealed class MobileMenuStrip : BoxContainer
+{
+    private readonly GridContainer _icons;
+    private readonly MobileHudIconButton _toggle;
+    public bool Collapsed { get; private set; }
+
+    public MobileMenuStrip()
+    {
+        Name = "MobileMenuStrip";
+        SeparationOverride = 4;
+        VerticalAlignment = VAlignment.Top;
+        _toggle = new MobileHudIconButton(MobileHudIconButton.Symbol.Fold, "MobileMenuToggle",
+            Loc.GetString("mobile-menu-toggle")) { VerticalAlignment = VAlignment.Top };
+        _toggle.OnPressed += _ => SetCollapsed(!Collapsed);
+        AddChild(_toggle);
+        _icons = new GridContainer { Name = "MobileMenuIcons", Columns = 7,
+            HSeparationOverride = 4, VSeparationOverride = 4 };
+        AddChild(_icons);
+    }
+
+    public void AddButton(Control button) => _icons.AddChild(button);
+    public void SetCollapsed(bool value)
+    {
+        Collapsed = value;
+        _icons.Visible = !value;
+        _toggle.Icon = value ? MobileHudIconButton.Symbol.Unfold : MobileHudIconButton.Symbol.Fold;
+        InvalidateMeasure();
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 availableSize)
+    {
+        var width = Root == null ? availableSize.X : MathF.Min(availableSize.X, Root.Size.X * 0.48f);
+        _icons.Columns = Math.Clamp((int)((width - 44) / 48), 1, 7);
+        return base.MeasureOverride(availableSize);
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs b/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs
new file mode 100644
index 0000000..8851c07
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileServerUiAdapter.cs
@@ -0,0 +1,296 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.Input;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+// Adapt live upstream/server widgets, not Content DLLs or their networking.
+// Sources remain in their screen so controller/widget lookup keeps working.
+internal sealed class MobileServerUiAdapter : Control
+{
+    private readonly Control _screenRoot;
+    private readonly Control _stateRoot;
+    private readonly List<ChatBinding> _chats = new();
+    private readonly List<MenuBinding> _menus = new();
+    private float _scanIn;
+    private int _layoutStamp;
+    private readonly Dictionary<long, (OutputPanel Output, float Start, float Last, bool Dragging)> _scrolls = new();
+
+    public MobileServerUiAdapter(Control screenRoot, Control stateRoot)
+    {
+        Name = "MobileServerUiAdapter";
+        _screenRoot = screenRoot;
+        _stateRoot = stateRoot;
+        MouseFilter = MouseFilterMode.Ignore;
+    }
+
+    private static IEnumerable<Control> Tree(Control control)
+    {
+        yield return control;
+        foreach (var child in control.Children)
+            foreach (var nested in Tree(child)) yield return nested;
+    }
+
+    private static bool TypeIs(Control control, string name)
+    {
+        for (var type = control.GetType(); type != null; type = type.BaseType)
+            if (type.Name == name) return true;
+        return false;
+    }
+
+    public void Update(float delta)
+    {
+        foreach (var chat in _chats.ToArray())
+            if (!chat.Source.IsInsideTree || chat.Source.Disposed)
+            {
+                chat.Restore();
+                _chats.Remove(chat);
+                InvalidateMeasure();
+            }
+        foreach (var menu in _menus.ToArray())
+            if (!menu.Source.IsInsideTree || menu.Source.Disposed)
+            {
+                menu.Restore();
+                _menus.Remove(menu);
+            }
+        _scanIn -= delta;
+        if (_scanIn <= 0)
+        {
+            _scanIn = 0.25f;
+            // Snapshot before changing child collections. Check base type names
+            // and original named controls; no dependency on a fork namespace.
+            var controls = Tree(_screenRoot).Concat(Tree(_stateRoot)).ToArray();
+            foreach (var source in controls)
+            {
+                // Never adapt our own presentation containers recursively.
+                if (source.GetType().Assembly == typeof(Control).Assembly) continue;
+                if ((TypeIs(source, "ChatBox") || source.Children.Any(c => c.Name == "ChatWindowPanel")) && !_chats.Any(c => c.Source == source))
+                    AttachChat(source);
+                if ((TypeIs(source, "GameTopMenuBar") || source.Children.Any(c => TypeIs(c, "MenuButton"))) && !_menus.Any(m => m.Source == source))
+                    AttachMenu(source);
+            }
+        }
+        foreach (var chat in _chats)
+        {
+            chat.Source.Visible = false;
+            chat.Dock.Visible = AncestorsVisible(chat.Source.Parent);
+        }
+        foreach (var menu in _menus) menu.Enforce();
+        var layout = new HashCode();
+        foreach (var control in _menus.Select(m => m.Source))
+        {
+            layout.Add(control.VisibleInTree); layout.Add(control.GlobalPosition); layout.Add(control.Size);
+        }
+        var stamp = layout.ToHashCode();
+        if (stamp != _layoutStamp) { _layoutStamp = stamp; InvalidateMeasure(); InvalidateArrange(); }
+    }
+
+    private static bool AncestorsVisible(Control? control)
+    {
+        while (control != null)
+        {
+            if (!control.Visible) return false;
+            control = control.Parent;
+        }
+        return true;
+    }
+
+    private void AttachChat(Control source)
+    {
+        var controls = Tree(source).ToArray();
+        var panel = controls.FirstOrDefault(c => c.Name == "ChatWindowPanel");
+        var input = controls.OfType<LineEdit>().FirstOrDefault(c => c.Name == "Input");
+        var output = controls.OfType<OutputPanel>().FirstOrDefault();
+        if (panel?.Parent == null || input?.Parent == null || output == null) return;
+        // Require the original channel/filter controls; never replace an
+        // unrelated text field or bypass server permission/channel handling.
+        if (!controls.Any(c => c.Name == "ChannelSelector") || !controls.Any(c => c.Name == "FilterButton")) return;
+        var binding = new ChatBinding(source, panel, input, output);
+        _chats.Add(binding);
+        AddChild(binding.Dock);
+        InvalidateMeasure();
+    }
+
+    private void AttachMenu(Control source)
+    {
+        var buttons = source.Children.Where(c => TypeIs(c, "MenuButton")).ToArray();
+        if (buttons.Length == 0) return;
+        _menus.Add(new MenuBinding(source, buttons));
+    }
+
+    public bool HandleTouch(TouchFingerEventArgs args, Control? hit, Action<long> cancelClick)
+    {
+        var id = args.FingerId;
+        var y = args.Coordinates.Position.Y;
+        if (args.Action == TouchFingerAction.Down)
+        {
+            _scrolls.Remove(id);
+            for (var control = hit; control != null; control = control.Parent)
+            {
+                if (control is not OutputPanel output || !_chats.Any(c => c.Output == output)) continue;
+                _scrolls[id] = (output, y, y, false);
+                break;
+            }
+            return false;
+        }
+        if (!_scrolls.TryGetValue(id, out var state)) return false;
+        if (args.Action != TouchFingerAction.Motion || !state.Output.VisibleInTree)
+        {
+            _scrolls.Remove(id);
+            return state.Dragging;
+        }
+        var dragging = state.Dragging || MathF.Abs(y - state.Start) >= 10 * UIScale;
+        if (dragging)
+        {
+            if (!state.Dragging) cancelClick(id);
+            state.Output.ScrollByDelta(y - (state.Dragging ? state.Last : state.Start));
+        }
+        _scrolls[id] = (state.Output, state.Start, y, dragging);
+        return dragging;
+    }
+
+    protected override Vector2 MeasureOverride(Vector2 availableSize)
+    {
+        foreach (var chat in _chats) chat.Dock.Measure(chat.Dock.DockSize(availableSize));
+        return Vector2.Zero;
+    }
+
+    protected override Vector2 ArrangeOverride(Vector2 finalSize)
+    {
+        var top = 56f;
+        foreach (var chat in _chats)
+        {
+            var desired = chat.Dock.DockSize(finalSize);
+            var left = 12f;
+            var right = finalSize.X - 12;
+            foreach (var menu in _menus)
+                if (menu.Source.VisibleInTree && menu.Source.GlobalPosition.Y < top + desired.Y)
+                    left = MathF.Max(left, menu.Source.GlobalPosition.X + menu.Source.Size.X + 12);
+            var size = chat.Dock.DockSize(finalSize, MathF.Max(42, right - left));
+            chat.Dock.Measure(size);
+            chat.Dock.Arrange(UIBox2.FromDimensions(new Vector2(MathF.Max(left, right - size.X), top), size));
+            top += size.Y + 6;
+        }
+        return finalSize;
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+        {
+            foreach (var chat in _chats) chat.Restore();
+            foreach (var menu in _menus) menu.Restore();
+            _chats.Clear(); _menus.Clear();
+        }
+        base.Dispose(disposing);
+    }
+
+    private sealed class ChatBinding
+    {
+        public readonly Control Source;
+        public readonly MobileChatDock Dock;
+        public readonly OutputPanel Output;
+        private readonly Control _panel;
+        private readonly Control _originalParent;
+        private readonly int _index;
+        private readonly bool _visible;
+        private readonly bool _panelVisible;
+        private readonly LineEdit _input;
+        private readonly string? _placeholder;
+        private readonly Vector2 _inputMin;
+        private readonly MobileHudIconButton _send;
+
+        public ChatBinding(Control source, Control panel, LineEdit input, OutputPanel output)
+        {
+            Source = source; Output = output; _panel = panel; _input = input;
+            _originalParent = panel.Parent!; _index = panel.GetPositionInParent(); _visible = source.Visible; _panelVisible = panel.Visible;
+            _placeholder = input.PlaceHolder; _inputMin = input.MinSize;
+            _originalParent.RemoveChild(panel);
+            Dock = new MobileChatDock(panel, input);
+            input.PlaceHolder = Loc.GetString("mobile-chat-placeholder");
+            input.MinHeight = MathF.Max(38, input.MinHeight);
+            _send = new MobileHudIconButton(MobileHudIconButton.Symbol.Send, "MobileChatSend", Loc.GetString("mobile-chat-send"));
+            // Same entry point as Enter/IME: history, selected channel, typing
+            // indicator, validation and the server's SendMessage stay intact.
+            _send.OnPressed += _ => input.ForceSubmitText();
+            input.Parent!.AddChild(_send);
+            source.Visible = false;
+        }
+
+        public void Restore()
+        {
+            _send.Dispose();
+            if (!_input.Disposed) { _input.PlaceHolder = _placeholder; _input.MinSize = _inputMin; }
+            if (!_panel.Disposed)
+            {
+                _panel.Parent?.RemoveChild(_panel);
+                _panel.Visible = _panelVisible;
+                if (!_originalParent.Disposed)
+                {
+                    _originalParent.AddChild(_panel);
+                    _panel.SetPositionInParent(Math.Min(_index, _originalParent.ChildCount - 1));
+                }
+                else _panel.Dispose();
+            }
+            if (!Source.Disposed) Source.Visible = _visible;
+            Dock.Dispose();
+        }
+    }
+
+    private sealed class MenuBinding
+    {
+        public readonly Control Source;
+        private readonly MobileMenuStrip _strip = new();
+        private readonly List<(Control Button, int Index, Vector2 Min, Vector2 Set)> _buttons = new();
+        private readonly List<(Control Label, bool Visible)> _labels = new();
+        private readonly List<(TextureRect Icon, bool Shrink, Vector2 Scale)> _icons = new();
+        private readonly Vector2 _min;
+        private readonly Thickness _margin;
+
+        public MenuBinding(Control source, Control[] buttons)
+        {
+            Source = source; _min = source.MinSize; _margin = source.Margin;
+            foreach (var button in buttons)
+            {
+                _buttons.Add((button, button.GetPositionInParent(), button.MinSize, button.SetSize));
+                foreach (var label in Tree(button).OfType<Label>()) _labels.Add((label, label.Visible));
+                foreach (var icon in Tree(button).OfType<TextureRect>())
+                    _icons.Add((icon, icon.CanShrink, icon.TextureScale));
+            }
+            foreach (var button in buttons) { source.RemoveChild(button); _strip.AddButton(button); }
+            source.AddChild(_strip);
+            Enforce();
+        }
+
+        public void Enforce()
+        {
+            Source.MinSize = Vector2.Zero;
+            Source.Margin = _margin;
+            foreach (var item in _buttons) { item.Button.MinSize = new Vector2(40); item.Button.SetSize = new Vector2(40); }
+            foreach (var item in _labels) item.Label.Visible = false;
+            foreach (var item in _icons) { item.Icon.CanShrink = true; item.Icon.TextureScale = new Vector2(0.35f); }
+        }
+
+        public void Restore()
+        {
+            foreach (var item in _labels) if (!item.Label.Disposed) item.Label.Visible = item.Visible;
+            foreach (var item in _icons) if (!item.Icon.Disposed) { item.Icon.CanShrink = item.Shrink; item.Icon.TextureScale = item.Scale; }
+            foreach (var item in _buttons)
+            {
+                if (item.Button.Disposed) continue;
+                item.Button.Parent?.RemoveChild(item.Button);
+                item.Button.MinSize = item.Min; item.Button.SetSize = item.Set;
+                if (!Source.Disposed) { Source.AddChild(item.Button); item.Button.SetPositionInParent(Math.Min(item.Index, Source.ChildCount - 1)); }
+                else item.Button.Dispose();
+            }
+            if (!Source.Disposed) { Source.MinSize = _min; Source.Margin = _margin; }
+            _strip.Dispose();
+        }
+    }
+}
