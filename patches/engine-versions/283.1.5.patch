new file mode 100644
index 0000000..39e9837
--- /dev/null
+++ b/Robust.Client/UserInterface/Mobile/MobileChatDock.cs
@@ -0,0 +1,86 @@
+using System;
+using System.Numerics;
+using Robust.Client.Graphics;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Localization;
+using Robust.Shared.Maths;
+
+namespace Robust.Client.UserInterface.Mobile;
+
+internal sealed class MobileChatDock : PanelContainer
+{
+    private readonly BoxContainer _column;
+    private readonly Control _content;
+    private readonly LineEdit _input;
+    private readonly MobileHudIconButton _expand;
+    private readonly MobileHudIconButton _hide;
+    private readonly Label _title;
+    public bool Expanded { get; private set; }
+    public bool Collapsed { get; private set; }
+
+    public MobileChatDock(Control content, LineEdit input)
+    {
+        Name = "MobileChatDock";
+        _content = content;
+        _input = input;
+        MouseFilter = MouseFilterMode.Stop;
+        PanelOverride = new StyleBoxFlat { BackgroundColor = Color.FromHex("#202128e8"),
+            BorderColor = Color.FromHex("#46485f"), BorderThickness = new Thickness(1) };
+        _column = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Vertical,
+            SeparationOverride = 2 };
+        AddChild(_column);
+        var header = new BoxContainer { Orientation = BoxContainer.LayoutOrientation.Horizontal,
+            SeparationOverride = 2 };
+        _column.AddChild(header);
+        _hide = new MobileHudIconButton(MobileHudIconButton.Symbol.Chat, "MobileChatToggle",
+            Loc.GetString("mobile-chat-toggle"));
+        _hide.OnPressed += _ => SetCollapsed(!Collapsed);
+        header.AddChild(_hide);
+        _title = new Label { Text = Loc.GetString("mobile-chat-title"), HorizontalExpand = true,
+            VerticalAlignment = VAlignment.Center, Margin = new Thickness(6, 0) };
+        header.AddChild(_title);
+        _expand = new MobileHudIconButton(MobileHudIconButton.Symbol.Expand, "MobileChatExpand",
+            Loc.GetString("mobile-chat-expand"));
+        _expand.OnPressed += _ => { Expanded = !Expanded; _expand.Icon = Expanded
+            ? MobileHudIconButton.Symbol.Compact : MobileHudIconButton.Symbol.Expand; UpdateLayout(); };
+        header.AddChild(_expand);
+        content.HorizontalExpand = true;
+        content.VerticalExpand = true;
+        _column.AddChild(content);
+        input.OnFocusEnter += InputFocused;
+    }
+
+    private void InputFocused(LineEdit.LineEditEventArgs _) => SetCollapsed(false);
+
+    public void SetCollapsed(bool value)
+    {
+        if (Collapsed == value) return;
+        if (value) _input.ReleaseKeyboardFocus();
+        Collapsed = value;
+        _content.Visible = !value;
+        _title.Visible = !value;
+        _expand.Visible = !value;
+        UpdateLayout();
+    }
+
+    private void UpdateLayout()
+    {
+        InvalidateMeasure();
+        Parent?.InvalidateMeasure();
+        Parent?.InvalidateArrange();
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing) _input.OnFocusEnter -= InputFocused;
+        base.Dispose(disposing);
+    }
+
+    public Vector2 DockSize(Vector2 available, float maxWidth = float.PositiveInfinity)
+    {
+        if (Collapsed) return new Vector2(42);
+        var width = MathF.Min(available.X - 24, Math.Clamp(available.X * (Expanded ? 0.56f : 0.36f), 300, Expanded ? 680 : 460));
+        var height = Expanded ? Math.Clamp(available.Y * 0.62f, 170, 430) : 172;
+        return Vector2.Max(new Vector2(42), new Vector2(MathF.Min(width, maxWidth), MathF.Min(height, available.Y - 72)));
+    }
+}
diff --git a/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs b/Robust.Client/UserInterface/Mobile/MobileHudIconButton.cs
