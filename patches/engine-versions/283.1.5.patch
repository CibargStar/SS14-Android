+using System;
+using System.Numerics;
+using Robust.Shared.Map;
+using Robust.Client.UserInterface.Mobile;
+
+namespace Robust.Client.Input;
+
+public enum TouchFingerAction
+{
+    Down,
+    Motion,
+    Up,
+    Cancel
+}
+
+public sealed class TouchFingerEventArgs : EventArgs
+{
+    internal Action<TouchMouseAction, ScreenCoordinates>? EmitMouse { get; set; }
+    public TouchFingerAction Action { get; }
+    public long FingerId { get; }
+    public ScreenCoordinates Coordinates { get; }
+
+    public TouchFingerEventArgs(TouchFingerAction action, long fingerId, ScreenCoordinates coordinates)
+    {
+        Action = action;
+        FingerId = fingerId;
+        Coordinates = coordinates;
+    }
+}
