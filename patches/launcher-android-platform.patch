+using System;
+using System.IO;
+using System.Text.Json.Nodes;
+
+namespace SS14.Launcher.Utility;
+
+public static class EngineCatalogMerge
+{
+    public static JsonObject Merge(JsonObject bundled, JsonObject online)
+    {
+        var merged = (JsonObject)bundled.DeepClone();
+        foreach (var (version, entry) in online)
+        {
+            if (entry is not JsonObject)
+                throw new InvalidDataException("Invalid online engine catalog entry.");
+            var replacement = (JsonObject)entry.DeepClone();
+            if (replacement["platforms"] is JsonObject remotePlatforms &&
+                bundled[version]?["platforms"] is JsonObject localPlatforms)
+            {
+                foreach (var (rid, platform) in remotePlatforms)
+                {
+                    if (platform is not JsonObject remote || localPlatforms[rid] is not JsonObject local)
+                        continue;
+                    var assetUrl = local["url"]?.GetValue<string>();
+                    if (assetUrl?.StartsWith("asset://engines/", StringComparison.Ordinal) == true &&
+                        string.Equals(remote["sha256"]?.GetValue<string>(), local["sha256"]?.GetValue<string>(), StringComparison.OrdinalIgnoreCase) &&
+                        string.Equals(remote["sig"]?.GetValue<string>(), local["sig"]?.GetValue<string>(), StringComparison.OrdinalIgnoreCase))
+                        remote["url"] = assetUrl;
+                }
+            }
+            // Online revocations, redirects and repaired package identities win.
+            // Retain a bundled URL only when it names the exact same signed bytes.
+            merged[version] = replacement;
+        }
+        return merged;
+    }
+}
