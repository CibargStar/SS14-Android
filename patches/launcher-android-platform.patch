diff --git a/SS14.Launcher/PlatformWindow.cs b/SS14.Launcher/PlatformWindow.cs
new file mode 100644
index 0000000..908b2ca
--- /dev/null
+++ b/SS14.Launcher/PlatformWindow.cs
@@ -0,0 +1,98 @@
+using System;
+using System.Threading.Tasks;
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Controls.Primitives;
+using Avalonia.Layout;
+using Avalonia.Media;
+using Avalonia.Platform;
+
+namespace SS14.Launcher;
+
+#if ANDROID_LAUNCHER
+// Android has a single Avalonia TopLevel. Preserve upstream dialog classes and XAML
+// by presenting their existing content modally inside that TopLevel.
+public class PlatformWindow : ContentControl
+{
+    public static readonly StyledProperty<string?> TitleProperty =
+        AvaloniaProperty.Register<PlatformWindow, string?>(nameof(Title));
+    public static readonly StyledProperty<WindowIcon?> IconProperty =
+        AvaloniaProperty.Register<PlatformWindow, WindowIcon?>(nameof(Icon));
+    private Action<object?>? _close;
+    public string? Title { get => GetValue(TitleProperty); set => SetValue(TitleProperty, value); }
+    public WindowIcon? Icon { get => GetValue(IconProperty); set => SetValue(IconProperty, value); }
+    public WindowStartupLocation WindowStartupLocation { get; set; }
+    public IPlatformHandle? TryGetPlatformHandle() => null;
+    public void Activate() => Focus();
+    public void Show() { }
+    protected virtual void OnOpened(EventArgs e) { }
+    public void Close() => Close(null);
+    public void Close(object? result)
+    {
+        if (_close is { } close) close(result);
+        else LauncherMobile.Exit?.Invoke();
+    }
+
+    public Task ShowDialog(PlatformWindow owner) => ShowDialog<object?>(owner);
+
+    public Task<T> ShowDialog<T>(PlatformWindow owner)
+    {
+        var root = LauncherMobile.Root ?? throw new InvalidOperationException("Android root is not initialized.");
+        if (_close != null) throw new InvalidOperationException("Dialog is already open.");
+        var completion = new TaskCompletionSource<T>(TaskCreationOptions.RunContinuationsAsynchronously);
+        var previousFocus = TopLevel.GetTopLevel(owner)?.FocusManager?.GetFocusedElement();
+        MinWidth = 0;
+        MaxWidth = double.PositiveInfinity;
+        MaxHeight = double.PositiveInfinity;
+        Height = double.NaN;
+        var closeButton = new Button { Content = "×", HorizontalAlignment = HorizontalAlignment.Right };
+        var title = new TextBlock { Text = Title, VerticalAlignment = VerticalAlignment.Center };
+        var header = new DockPanel { LastChildFill = true };
+        DockPanel.SetDock(closeButton, Dock.Right);
+        header.Children.Add(closeButton);
+        header.Children.Add(title);
+        var panel = new DockPanel();
+        DockPanel.SetDock(header, Dock.Top);
+        panel.Children.Add(header);
+        var contentScroll = new ScrollViewer
+        {
+            Content = this,
+            HorizontalScrollBarVisibility = ScrollBarVisibility.Auto,
+            VerticalScrollBarVisibility = ScrollBarVisibility.Auto
+        };
+        panel.Children.Add(contentScroll);
+        var frame = new Border
+        {
+            Background = new SolidColorBrush(Color.Parse("#212126")), Padding = new Thickness(8),
+            HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center,
+            MaxHeight = Math.Max(1, root.Bounds.Height - 24),
+            MaxWidth = Math.Max(1, root.Bounds.Width - 24),
+            Child = panel
+        };
+        var overlay = new Grid { Background = new SolidColorBrush(Color.Parse("#AA000000")) };
+        overlay.Children.Add(frame);
+        Action closeAction = () => Close();
+        var wasEnabled = owner.IsEnabled;
+        owner.IsEnabled = false;
+        LauncherMobile.DialogClosers.Push(closeAction);
+        _close = value =>
+        {
+            if (LauncherMobile.DialogClosers.Peek() != closeAction)
+                throw new InvalidOperationException("Dialogs must close in presentation order.");
+            LauncherMobile.DialogClosers.Pop();
+            root.Children.Remove(overlay);
+            contentScroll.Content = null;
+            owner.IsEnabled = wasEnabled;
+            _close = null;
+            previousFocus?.Focus();
+            completion.TrySetResult(value is null ? default! : (T)value);
+        };
+        closeButton.Click += (_, _) => Close();
+        root.Children.Add(overlay);
+        OnOpened(EventArgs.Empty);
+        return completion.Task;
+    }
+}
+#else
+public class PlatformWindow : Window { }
+#endif
