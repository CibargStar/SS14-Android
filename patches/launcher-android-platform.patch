+namespace SS14.Launcher.Models;
+
+// The launcher keeps its existing connect/update lifecycle while Android supplies
+// an Activity-backed process instead of invoking a desktop executable.
+public interface IClientProcess
+{
+    bool HasExited { get; }
+    int ExitCode { get; }
+    Task WaitForExitAsync(CancellationToken cancel);
+}
+
+internal sealed class DesktopClientProcess(Process process) : IClientProcess
+{
+    public bool HasExited => process.HasExited;
+    public int ExitCode => process.ExitCode;
+    public Task WaitForExitAsync(CancellationToken cancel) => process.WaitForExitAsync(cancel);
+}
