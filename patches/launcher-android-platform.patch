diff --git a/SS14.Loader/MobileLoader.cs b/SS14.Loader/MobileLoader.cs
new file mode 100644
index 0000000..131aec8
--- /dev/null
+++ b/SS14.Loader/MobileLoader.cs
@@ -0,0 +1,59 @@
+using System;
+using System.IO;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using System.Runtime.Loader;
+using Robust.LoaderApi;
+
+namespace SS14.Loader;
+
+// Platform entry into the original signed loader. This does not load Content.Client
+// from the APK; the original ContentDbFileApi supplies the installed server build.
+public static class MobileLoader
+{
+    public static string? NativeDirectory { get; private set; }
+    public static Action<string, string>? Redial { get; private set; }
+
+    public static int Run(string[] arguments, string nativeDirectory, Action<string, string> redial)
+    {
+        NativeDirectory = nativeDirectory;
+        Redial = redial;
+        return Program.Main(arguments);
+    }
+
+    internal sealed class RedialAdapter : IRedialApi
+    {
+        public void Redial(Uri uri, string text = "") =>
+            (MobileLoader.Redial ?? throw new InvalidOperationException("Android redial is unavailable."))(uri.ToString(), text);
+    }
+}
+
+internal sealed class MobileEngineLoadContext(IFileApi files, string nativeDirectory)
+    : AssemblyLoadContext("Robust.Android.Engine", isCollectible: false)
+{
+    protected override Assembly? Load(AssemblyName name)
+    {
+        if (name.Name == typeof(ILoaderEntryPoint).Assembly.GetName().Name)
+            return typeof(ILoaderEntryPoint).Assembly;
+        if (!files.TryOpen(name.Name + ".dll", out var stream)) return null;
+        using (stream) return LoadFromStream(stream);
+    }
+
+    protected override IntPtr LoadUnmanagedDll(string name)
+    {
+        var mapped = name switch
+        {
+            "SDL3" or "SDL3.dll" => "libSDL3.so",
+            "freetype6" or "freetype6.dll" or "libfreetype.so.6" or "libfreetype6.so" => "libfreetype.so",
+            "AL" or "libAL.so" or "OpenAL32.dll" or "openal32" or "libopenal.so.1" => "libopenal.so",
+            "libEGL.dll" => "libEGL.so",
+            "libdl.so.2" => "libdl.so",
+            "zstd" or "zstd.so" or "libzstd.so.1" => "libzstd.so",
+            "sodium" or "libsodium" => "libsodium.so",
+            _ => name
+        };
+        if (mapped.Contains('/') || mapped.Contains('\\')) return IntPtr.Zero;
+        return NativeLibrary.TryLoad(Path.Combine(nativeDirectory, mapped), out var result) ||
+               NativeLibrary.TryLoad(mapped, out result) ? result : IntPtr.Zero;
+    }
+}
