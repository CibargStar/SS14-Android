diff --git a/SS14.Launcher/LauncherFitViewport.cs b/SS14.Launcher/LauncherFitViewport.cs
new file mode 100644
index 0000000..7f5669b
--- /dev/null
+++ b/SS14.Launcher/LauncherFitViewport.cs
@@ -0,0 +1,40 @@
+using System;
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Media;
+
+namespace SS14.Launcher;
+
+// Measure the responsive upstream views against the actual Android viewport.
+// Uniform downscaling is only a fallback below the minimum usable mobile size.
+public sealed class LauncherFitViewport(Size minimum) : Decorator
+{
+    public double Scale { get; private set; } = 1;
+
+    private Size LogicalSize(Size available)
+    {
+        var width = double.IsFinite(available.Width) ? Math.Max(1, available.Width) : minimum.Width;
+        var height = double.IsFinite(available.Height) ? Math.Max(1, available.Height) : minimum.Height;
+        Scale = Math.Min(1, Math.Min(width / minimum.Width, height / minimum.Height));
+        return new Size(width / Scale, height / Scale);
+    }
+
+    protected override Size MeasureOverride(Size availableSize)
+    {
+        var logical = LogicalSize(availableSize);
+        Child?.Measure(logical);
+        return new Size(logical.Width * Scale, logical.Height * Scale);
+    }
+
+    protected override Size ArrangeOverride(Size finalSize)
+    {
+        var logical = LogicalSize(finalSize);
+        if (Child is { } child)
+        {
+            child.RenderTransformOrigin = RelativePoint.TopLeft;
+            child.RenderTransform = new ScaleTransform(Scale, Scale);
+            child.Arrange(new Rect(logical));
+        }
+        return finalSize;
+    }
+}
