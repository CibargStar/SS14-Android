diff --git a/SS14.Launcher/Models/EngineManager/EngineBinaryPatch.cs b/SS14.Launcher/Models/EngineManager/EngineBinaryPatch.cs
new file mode 100644
index 0000000..07cb7b4
--- /dev/null
+++ b/SS14.Launcher/Models/EngineManager/EngineBinaryPatch.cs
@@ -0,0 +1,91 @@
+using System;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SS14.Launcher.Models.EngineManager;
+
+// Deterministic data-only delta. It never executes scripts, loads an assembly or
+// extracts paths. Both input packages must be authenticated before calling this;
+// the existing installer authenticates the complete generated engine afterward.
+public static class EngineBinaryPatch
+{
+    private sealed record Header(int Format, string Version, string SourceSha256,
+        string TargetSha256, long TargetLength);
+
+    public static async Task Apply(Stream source, Stream delta, Stream target,
+        string version, string expectedHash, CancellationToken cancel = default)
+    {
+        using var reader = new BinaryReader(delta, Encoding.UTF8, leaveOpen: true);
+        if (!reader.ReadBytes(8).AsSpan().SequenceEqual("SS14DP01"u8))
+            throw new InvalidDataException("Unknown Android engine patch format.");
+        var headerLength = reader.ReadInt32();
+        if (headerLength is <= 0 or > 65536)
+            throw new InvalidDataException("Invalid Android engine patch header.");
+        var header = JsonSerializer.Deserialize<Header>(reader.ReadBytes(headerLength),
+            new JsonSerializerOptions(JsonSerializerDefaults.Web))
+            ?? throw new InvalidDataException("Empty Android engine patch header.");
+        if (header.Format != 1 || header.Version != version ||
+            header.TargetLength is <= 0 or > 512L * 1024 * 1024 ||
+            !string.Equals(header.TargetSha256, expectedHash, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("Android engine patch does not match the requested build.");
+        source.Position = 0;
+        if (!CryptographicOperations.FixedTimeEquals(await SHA256.HashDataAsync(source, cancel),
+                Convert.FromHexString(header.SourceSha256)))
+            throw new CryptographicException("Android engine patch source hash mismatch.");
+        var buffer = new byte[64 * 1024];
+        var written = 0L;
+        for (var operation = 0; operation < 100000; operation++)
+        {
+            cancel.ThrowIfCancellationRequested();
+            var code = reader.ReadByte();
+            if (code == 255)
+            {
+                if (written != header.TargetLength || delta.ReadByte() != -1)
+                    throw new InvalidDataException("Android engine patch length mismatch.");
+                await target.FlushAsync(cancel);
+                target.Position = 0;
+                if (!CryptographicOperations.FixedTimeEquals(await SHA256.HashDataAsync(target, cancel),
+                        Convert.FromHexString(expectedHash)))
+                    throw new CryptographicException("Generated Android engine hash mismatch.");
+                target.Position = 0;
+                return;
+            }
+            Stream input;
+            long length;
+            if (code == 0)
+            {
+                var offset = reader.ReadInt64();
+                length = reader.ReadInt64();
+                if (offset < 0 || length <= 0 || length > source.Length || offset > source.Length - length)
+                    throw new InvalidDataException("Android engine patch copy is outside its source.");
+                source.Position = offset;
+                input = source;
+            }
+            else if (code == 1)
+            {
+                length = reader.ReadInt64();
+                input = delta;
+            }
+            else throw new InvalidDataException("Unknown Android engine patch operation.");
+            if (length <= 0 || length > header.TargetLength - written)
+                throw new InvalidDataException("Android engine patch exceeds its output limit.");
+            var remaining = length;
+            while (remaining > 0)
+            {
+                var read = await input.ReadAsync(buffer.AsMemory(0, (int)Math.Min(buffer.Length, remaining)), cancel);
+                if (read == 0) throw new EndOfStreamException("Truncated Android engine patch.");
+                await target.WriteAsync(buffer.AsMemory(0, read), cancel);
+                remaining -= read;
+            }
+            written += length;
+        }
+        throw new InvalidDataException("Too many Android engine patch operations.");
+    }
+}
+
+public sealed record EnginePatchInfo(string SourceUrl, string SourceSha256, string SourceSignature,
+    string Url, string Sha256, string Signature);
